# Copy to tools/local.env (git-ignored) and edit. Every tools/ and work/ shell script that needs one of these reads
# tools/local.env first if it exists; a variable already set in the environment also works. Python tools read the
# environment only (export the variable, or run them from a script that sourced this file).
#
# Folder that holds this repository's tools/ and the work/, games/, deps/, ps5/ folders (default: $HOME/inFamous).
#export IF_ROOT="$HOME/inFamous"
# PS5 address for the FTP / log / upload helpers in tools/ps5 (FTP server on port 2121). Required by those scripts.
#export PS5_IP=192.0.2.10
# RPCS3 folder that contains dev_flash/ (PC test runs and the data staging scripts). Required by those scripts.
#export RPCS3_DIR="$HOME/.config/rpcs3"
# Only for tools/ps5/package_if2.sh (make_sce_art.py of another PS5 port's tools):
#export MP3_PS5_DIR=/path/to/mp3-ps5
