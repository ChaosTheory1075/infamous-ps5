# CMake toolchain: ps3recomp / inFamous 2 for the PS5 (x86_64-sie-ps5, payload SDK, plume-triangle).
set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER $ENV{HOME}/if2/ps5/ps5cc)
set(CMAKE_CXX_COMPILER $ENV{HOME}/if2/ps5/ps5cc)
set(CMAKE_ASM_COMPILER $ENV{HOME}/if2/ps5/ps5cc)
set(CMAKE_AR /usr/bin/llvm-ar-18 CACHE FILEPATH "")
set(CMAKE_RANLIB /usr/bin/llvm-ranlib-18 CACHE FILEPATH "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(PS5_PACBREW $ENV{HOME}/mp3build/tri/.deps/pacbrew/v0.40.2/sysroot/user/homebrew)
set(CMAKE_FIND_ROOT_PATH ${PS5_PACBREW} $ENV{HOME}/if2/ps5/prefix)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_C_FLAGS_INIT "-fPIC -ffunction-sections -fdata-sections")
set(CMAKE_CXX_FLAGS_INIT "-fPIC -ffunction-sections -fdata-sections")
