+    const int minlin = minf == 2 || minf == 4 || minf == 6;
+    const int maglin = magf == 2;
+    out->enabled = (base == 0x91 || base == 0x93 || func > 7 || dimension != 2 || cube || mips > 1 ||
+        minf < 1 || minf > 6 || magf < 1 || magf > 2 || minlin != maglin) ? 2 : 1;
