+{
+    int v = __atomic_load_n(&s_fp_shadow_d24, __ATOMIC_RELAXED);
+    if (v < 0) { const char* e = getenv("PS3RECOMP_ENG_SHADOW_D24"); v = e && *e ? atoi(e) : 0;
