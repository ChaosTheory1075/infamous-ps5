+SPU__XV_INLINE u128 name(u128 a, u128 b) {                                                     \
+    const __m128 x = spu__fz_m(a), y = spu__fz_m(b); __m128 r;                                  \
+    __asm__(insn " %2, %1, %0" : "=x"(r) : "x"(x), "x"(y));                                     \
