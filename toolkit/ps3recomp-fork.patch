+#endif
+/* RSX thread: g[0] = waits the doorbell ref hold made full sleeps since the last call, g[1] = re-entry tripwire
+ * hits (run total; anything but 0 is a bug in gcm_db_pending). */
+void cellGcm_rsx_guard_counts(unsigned g[2])
+{
+    g[0] = s_ref_holds; s_ref_holds = 0;
+    g[1] = __atomic_load_n(&s_db_reentry, __ATOMIC_RELAXED);
