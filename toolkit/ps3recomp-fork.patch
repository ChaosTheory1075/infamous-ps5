+        if (!expanded) return;
+        for (NSUInteger i = 0; i < w * h; i++) {
+            expanded[i * 4] = p[i * 4 + 1]; expanded[i * 4 + 1] = p[i * 4 + 3];
+            expanded[i * 4 + 2] = 0; expanded[i * 4 + 3] = 255;
