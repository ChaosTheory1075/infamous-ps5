+ * that softens the 1024x1024 sun cascades' texel stair-steps on the street
+ * and the hard edges of the per-texel height-displaced terrain lookups
+ * (FP 20e579e1b50ec50d / 0a1fd0e8c0ad368c). */
+static int s_fp_shadow_pcf = -1;
+void rsx_fp_set_shadow_pcf(int n) { __atomic_store_n(&s_fp_shadow_pcf, n < 0 ? 0 : n > 3 ? 3 : n, __ATOMIC_RELAXED); }
