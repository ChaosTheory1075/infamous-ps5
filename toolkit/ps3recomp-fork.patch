+    if (ha && ga && ha != ga) {
+        s = (s * ga + ha / 2u) / ha;
+        if (!s_occ.st_scaled++)
+            fprintf(stderr, "[occ query] counted on a %ux%u target for a %ux%u guest surface: counts scaled by %.4f\n",
+                    w, h, q->gw, q->gh, (double)ga / (double)ha);
+    }
+    s += q->sum;
+    q->sum = (u32)(s > 0xFFFFFFFFull ? 0xFFFFFFFFull : s); q->any = 1;
+}
+/* Every host query of a waiting report is answered: its count becomes the key's last value (s_occ.mu held). */
+static int eng_occ_complete(eng_occ_req* q)
+{
+    if (q->got != (u8)((1u << q->n) - 1u)) return 0;
+    if (q->any) {
+        const u32 hs = eng_occ_hist_slot(q->key, 1);
+        s_occ.hist[hs].value = q->sum; s_occ.hist[hs].frame = s_occ.frame;
+        if (q->ord < ENG_OCC_ORD) { s_occ.ordv[q->slot_i][q->ord].value = q->sum; s_occ.ordv[q->slot_i][q->ord].frame = s_occ.frame;
+                                    s_occ.ordv[q->slot_i][q->ord].used = 1; }
+        s_occ.st_resolved++; s_occ.st_lat += s_occ.frame - q->frame;
+        if (q->sum < s_occ.st_min) s_occ.st_min = q->sum;
+        if (q->sum > s_occ.st_max) s_occ.st_max = q->sum;
+    } else s_occ.st_nodraw++;   /* nothing of it was drawn (or its result was lost): the last value stays */
+    q->used = 0; s_occ.pend_n--;
+    return 1;
+}
+
+/* The backend's answer for one host query id (any thread). */
+void rsx_draw_engine_occq_result(u32 id, u32 samples, u32 w, u32 h)
+{
+    if (samples == RSX_OCCQ_FAILED) {
+        if (!__atomic_exchange_n(&s_occ.failed, 1, __ATOMIC_RELAXED))
+            fprintf(stderr, "[occ query] the backend cannot count samples: GET_REPORT goes back to the constant\n");
+        return;
+    }
+    pthread_mutex_lock(&s_occ.mu);
+    s_occ.recent[s_occ.recent_w].id = id; s_occ.recent[s_occ.recent_w].samples = samples;
+    s_occ.recent[s_occ.recent_w].w = w; s_occ.recent[s_occ.recent_w].h = h;
+    s_occ.recent_w = (s_occ.recent_w + 1u) % 64u;
+    for (u32 i = 0; i < ENG_OCC_PEND && s_occ.pend_n; i++) {
+        eng_occ_req* q = &s_occ.pend[i];
+        if (!q->used) continue;
+        for (u32 k = 0; k < q->n; k++)
+            if (q->ids[k] == id && !((q->got >> k) & 1u)) eng_occ_apply(q, k, samples, w, h);
+        eng_occ_complete(q);
+    }
+    pthread_mutex_unlock(&s_occ.mu);
+}
+
+int rsx_draw_engine_occq_report(u32 report_off, u32* value)
+{
+    if (!g.ready || !g.be || !g.be->occq_begin || !g.be->occq_end || __atomic_load_n(&s_occ.failed, __ATOMIC_RELAXED)) {
+        if (s_occ.open && g.be && g.be->occq_end) { g.be->occq_end(g.be->user); s_occ.open = 0; }
+        return 0;
+    }
+    if (!s_occ.armed) {
+        s_occ.armed = 1; s_occ.seg_n = 0; s_occ.key = ENG_OCC_KEY0;
+        fprintf(stderr, "[occ query] ZPASS_PIXEL_CNT reports are measured with occlusion queries from now on (first report offset 0x%X)\n", report_off);
+    }
+    u32 si = 0;
+    while (si < s_occ.n_slots && s_occ.slot_off[si] != report_off) si++;
+    if (si == s_occ.n_slots) { if (s_occ.n_slots < ENG_OCC_SLOTS) s_occ.slot_off[s_occ.n_slots++] = report_off; else si = ENG_OCC_SLOTS - 1u; }
+    const u32 ord = s_occ.ord[si] < 0xFFFFu ? s_occ.ord[si]++ : 0xFFFFu;
+    u64 key = s_occ.key ^ ((u64)report_off * 0x9E3779B97F4A7C15ull);
+    if (!key) key = 1;
+    rsx_dsp_surface sf;
+    rsx_dsp_get_surface(&g.rsx, &sf);
+    u32 v = 0;
+    /* The report waits for its host queries BEFORE the open one is ended below: a backend may answer an id from
+     * inside occq_end (no draw reached it) or from its own thread right after. Ids that ended before this
+     * report (the count was switched off first, or an earlier GET_REPORT without a CLEAR took them) may be
+     * answered already: those come from the recent answers. */
+    pthread_mutex_lock(&s_occ.mu);
+    s_occ.st_reports++;
+    if (!s_occ.seg_n) s_occ.st_empty++;   /* nothing was counted since the CLEAR: the RSX reports 0 too */
+    else {
+        const u32 hs = eng_occ_hist_slot(key, 0);
+        if (hs < ENG_OCC_HIST) { v = s_occ.hist[hs].value; s_occ.hist[hs].frame = s_occ.frame; s_occ.st_hit++; }
+        else if (ord < ENG_OCC_ORD && s_occ.ordv[si][ord].used && s_occ.frame - s_occ.ordv[si][ord].frame <= 8u) {
+            v = s_occ.ordv[si][ord].value; s_occ.st_ord++; }
+        else s_occ.st_none++;
+        u32 pi = s_occ.pend_w;
+        for (u32 n = 0; n < ENG_OCC_PEND && s_occ.pend[pi].used; n++) pi = (pi + 1u) % ENG_OCC_PEND;
+        eng_occ_req* q = &s_occ.pend[pi];
+        if (q->used) { s_occ.st_lost++; s_occ.pend_n--; }   /* full: a waiting report is given up */
+        memset(q, 0, sizeof *q);
+        q->n = (u8)s_occ.seg_n; memcpy(q->ids, s_occ.seg, s_occ.seg_n * sizeof q->ids[0]);
+        q->used = 1; q->slot_i = (u8)si; q->ord = (u16)ord; q->key = key;
+        q->gw = sf.clip_w; q->gh = sf.clip_h; q->frame = s_occ.frame;
+        s_occ.pend_w = (pi + 1u) % ENG_OCC_PEND; s_occ.pend_n++;
+        for (u32 k = 0; k < q->n; k++)   /* ids that ended earlier (a previous report, or ENABLE 0 before this one) */
+            for (u32 r = 0; r < 64u; r++)
+                if (s_occ.recent[r].id == q->ids[k]) { eng_occ_apply(q, k, s_occ.recent[r].samples, s_occ.recent[r].w, s_occ.recent[r].h); break; }
+        eng_occ_complete(q);
+    }
+    pthread_mutex_unlock(&s_occ.mu);
+    eng_occ_stop();    /* what was counted up to here is this report */
+    *value = v;
+    /* GET_REPORT does not clear: with the count still enabled, a later report includes this one. The count goes on
+     * with the next draw (sink_begin), not here: both titles switch it off right after the report. */
+    s_occ.resume = s_occ.enabled;
+    return 1;
+}
+
+void rsx_draw_engine_report_written(u32 io_offset, u32 bytes)
+{
+    if (io_offset < s_occ_rep_lo) s_occ_rep_lo = io_offset;
+    if (io_offset + bytes > s_occ_rep_hi) s_occ_rep_hi = io_offset + bytes;
+    s_occ_rep_serial++;
+    s_dt.valid = 0;   /* eng draw fast: its template's textures were bound before this report */
+    eng_dtm_flush();   /* eng draw fast N */
+}
