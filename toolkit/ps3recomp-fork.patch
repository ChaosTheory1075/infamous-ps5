+int rsx_draw_engine_write_back(int local, u32 offset, u32 pitch)
+{
+    return rsx_draw_engine_write_back_to(local, offset, pitch, -1, 0);
+}
+
+/* gl blit skip (rsxwaste, cellGcmSys.c PS3_GCM_BLIT_GL_SKIP): 1 = the last write_back_to was a GPU-light copy whose
+ * write-back eng_gpu_light_blit skipped (no SPU job reads it: PS3RECOMP_ENG_GPU_SSAO without _WB). RSX thread only. */
+int g_eng_gl_blit_nowb;
+int rsx_draw_engine_write_back_to(int local, u32 offset, u32 pitch, int dst_local, u32 dst_offset)
+{
+    g_eng_gl_blit_nowb = 0;   /* gl blit skip */
+    if (!g.ready || !g.be->readback || !g.be->submit_and_wait) return 0;
+    { static int lg = -1; static _Atomic unsigned n;
+      if (lg < 0) lg = getenv("PS3RECOMP_ENG_BLIT_LOG") ? 1 : 0;
+      static u32 seen[96][2]; static unsigned ns;
+      int fresh = 0;
+      if (lg) {
+          static pthread_mutex_t m = PTHREAD_MUTEX_INITIALIZER;
+          pthread_mutex_lock(&m);
+          unsigned k = 0;
+          while (k < ns && !(seen[k][0] == offset && seen[k][1] == dst_offset)) k++;
+          if (k == ns && ns < 96) { seen[ns][0] = offset; seen[ns][1] = dst_offset; ns++; fresh = 1; }
+          pthread_mutex_unlock(&m);
+      }
+      if (fresh && ++n)
+          fprintf(stderr, "[blit log] %s 0x%08X pitch %u -> %s 0x%08X\n", local ? "local" : "main",
