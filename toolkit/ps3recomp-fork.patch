+#define SPU__FZ3(name, insn, op, exact)                                                        \
+SPU__XV_INLINE u128 name(u128 a, u128 b, u128 c) {                                             \
+    const __m128 x = spu__fz_m(a), y = spu__fz_m(b), z = spu__fz_m(c); __m128 r;                \
+    __asm__(insn " %3, %2, %0" : "=x"(r) : "0"(x), "x"(y), "x"(z));                             \
+    SPU__AX_POS0(r);                                                                           \
