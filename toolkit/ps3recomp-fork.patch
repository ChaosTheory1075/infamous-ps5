+{
+    int v = __atomic_load_n(&s_fp_shadow_rsx, __ATOMIC_RELAXED);
+    if (v < 0) { const char* e = getenv("PS3RECOMP_ENG_SHADOW_CMP"); v = !(e && *e == '0');
