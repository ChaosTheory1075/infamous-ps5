+    if (f)  fclose(f);
+    if (fa) fclose(fa);
+    free(expanded);
+    fprintf(stderr, "[rsx engine/metal] dumptex: %lux%lu fmt %lu -> %s.ppm and .a.ppm\n",
+            (unsigned long)w, (unsigned long)h, (unsigned long)pf, path);
+}
