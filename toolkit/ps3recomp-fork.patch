+                s_dtm_inel[DTM_I_NOVBUF], s_dtm_inel[DTM_I_NOMEMO], s_dtm_inel[DTM_I_RIB], s_dtm_inel[DTM_I_VPCFULL],
+                s_dtm_inel[DTM_I_NOZETA], s_dtm_inel[DTM_I_MRT], s_dtm_inel[DTM_I_FPBIG], s_dtm_inel[DTM_I_DBZ],
+                s_dtm_inel[DTM_I_VTEX], s_dtm_inel[DTM_I_NOPROG], s_dtm_evict, s_dtm_volrec, s_dtm_flushes, s_dtm_forgot, kl);
+        if (s_dtm_ideal)
+            fprintf(stderr, "[draw fast] ideal: %u of %u templates had a key already recorded this frame\n", s_dtm_ideal_seen, s_dtm_ideal_n);
+        if (s_dtm_verify)
+            fprintf(stderr, "[dt verify] replays checked: %llu ok, %llu MISMATCH (%llu on volatile slots; xf %llu fpconst %llu texmask %llu tex %llu samp %llu"
+                            " sc %llu sref %llu pipe %llu targets %llu misc %llu; ucp %llu vtexmask %llu xregs %llu texunits %llu stamps %llu"
+                            " vtexwant %llu dbounds %llu), %llu not reaching a record, exposed without B3: wb %llu newer-depth %llu, frame %u\n",
+                    s_dtv_ok, s_dtv_bad, s_dtv_bad_vol, s_dtv_by[0], s_dtv_by[1], s_dtv_by[2], s_dtv_by[3], s_dtv_by[4], s_dtv_by[5], s_dtv_by[6],
