+{
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++)
+        if (((mask >> u) & 1u) && treg[u][0] == offset && eng_dtk_uloc(treg[u]) == location) return 1;
+    return 0;
+}
+static int eng_dtk_light_addr(u32 location, u32 offset)   /* the GPU light / SSAO buffers (eng_gpu_*_texture) */
+{
+    if (location == RSX_LOCATION_MAIN && eng_gpu_light_on() && (offset == s_gl.diff_off || offset == s_gl.spec_off)) return 1;
+    return location == RSX_LOCATION_LOCAL && s_gs.on > 0 && offset == s_gs.off;
+}
+/* Record rules (counted): a full-path draw that may not become a template. A2: the draw-fast templates keep the old
+ * rule (no bound vertex unit, tested outside); the caster template now too (vbound). A6: depth bounds wanted without a copy yet; for the caster also a bound copy (s_dbz.unit: the
+ * caster template does not exclude it, and its own depth writes make the copy stale). A7: a unit at the address of
+ * the zeta the draw writes (its own depth / stencil write changes what that unit resolves to for the next draw: the
+ * first write turns guest bytes into a depth copy, every later one makes a new copy). A8: a unit at the GPU light /
+ * SSAO buffers (what they resolve to follows the light job's inputs and parameters, which no register shows). */
+static int eng_dtk_inel(u32 tex_mask, u32 zslot, const rsx_be_render_state* rs, int caster, u32 vbound)
+{
+    if (!eng_dtk_on()) return 0;
+    int why = -1;
+    if (caster && vbound) why = DTK_I_VTEX;   /* the caster replay binds its vertex units without comparing them */
+    else if (s_dbz_pend || (caster && s_dbz.unit)) why = DTK_I_DBP;
+    else {
+        const int zw = zslot < g.n_zdepths && ((rs->depth_test && rs->depth_write) || eng_stencil_writes(rs));
+        for (u32 u = 0; u < RSX_BE_MAX_TEXTURES && why < 0; u++) {
+            if (!((tex_mask >> u) & 1u)) continue;
+            const u32 off = rsx_dsp_reg(&g.rsx, 0x1A00u + u * 0x20u);
+            const u32 loc = (rsx_dsp_reg(&g.rsx, 0x1A04u + u * 0x20u) & 3u) == 2u ? RSX_LOCATION_MAIN : RSX_LOCATION_LOCAL;
+            if (zw && g.zdepths[zslot].offset == off && g.zdepths[zslot].location == loc) why = DTK_I_ZSELF;
+            else if (eng_dtk_light_addr(loc, off)) why = DTK_I_LIGHT;
+        }
+    }
+    if (why < 0) return 0;
+    s_dtk_n[why]++;
+    return 1;
+}
+/* A7: what a unit at (location, offset) resolves to may change here: a colour target or depth buffer made there,
+ * a clear of one (its stamp moves, its depth copies go), so a template binding such a unit is dropped. The single
+ * template otherwise lives on across clears and dropped full-path draws. */
+static void eng_dtk_addr_event(u32 location, u32 offset)
+{
+    if (s_dtm_n > 1 && eng_dtn_on())   /* dtn fix B1: a slot's unit there was a guest-memory (or other) binding */
+        for (int i = 0; i < s_dtm_n; i++) {
+            eng_dt_tpl* t = &s_dtm[i].t;
+            if (t->valid && t->frame == g.frames && eng_dtk_unit_at(t->tex_mask, t->treg, location, offset)) { t->valid = 0; s_dtn_ev++; }
+        }
+    if (!eng_dtk_on()) return;
+    if (s_dt.valid && eng_dtk_unit_at(s_dt.tex_mask, s_dt.treg, location, offset)) { s_dt.valid = 0; s_dtk_n[DTK_D_ADDR]++; }
+    if (s_ct.valid && eng_dtk_unit_at(s_ct.tex_mask, s_ct.treg, location, offset)) { s_ct.valid = 0; s_dtk_n[DTK_D_ADDR]++; }
+}
+/* dtn fix B1: the colour targets / depth buffers at (location, offset). A unit there resolves by their stamps,
+ * had_write and copies (sink_bind_textures), i.e. by what other draws did since. Mode 2 adds each to the slot's
+ * stamp list (every target bind and every depth write moves a stamp; a clear or a new target at the address drops
+ * the slot: eng_dtk_addr_event); 1 = the slot must be volatile instead (mode 1, a GPU light / SSAO buffer, or the
+ * list is full). */
+static int eng_dtn_rt_at(eng_dtm_slot* s, u32 location, u32 offset)
+{
+    if (eng_dtk_light_addr(location, offset)) return 1;
+    for (u32 k = 0; k < 2; k++) {
+        const u32 n = k ? g.n_zdepths : g.n_surfaces;
+        for (u32 i = 0; i < n; i++) {
+            const u32 h = k ? g.zdepths[i].handle : g.surfaces[i].handle;
+            const u32 lo = k ? g.zdepths[i].location : g.surfaces[i].location, of = k ? g.zdepths[i].offset : g.surfaces[i].offset;
+            if (!h || lo != location || of != offset) continue;
+            if (s_dtn == 1) return 1;
+            const u32 id = (k << 15) | i; int dup = 0;
+            for (u32 j = 0; j < s->ns; j++) dup |= s->sid[j] == id;
+            if (dup) continue;
+            if (s->ns >= ENG_DTN_ST) return 1;
+            s->sid[s->ns] = (u16)id; s->sst[s->ns++] = k ? g.zdepths[i].stamp : g.surfaces[i].stamp;
+        }
+    }
+    return 0;
+}
+static int eng_dtn_stamps_ok(const eng_dtm_slot* s)   /* mode 2: the slot's sampled targets unchanged since its record */
+{
+    for (u32 j = 0; j < s->ns; j++) {
+        const u32 i = s->sid[j] & 0x7FFFu;
+        if ((s->sid[j] >> 15) ? g.zdepths[i].stamp != s->sst[j] : g.surfaces[i].stamp != s->sst[j]) return 0;
+    }
+    return 1;
+}
+/* A9 (B3): a replay bumps its colour targets' stamps as eng_current_target_set does on the full path (eng_surface_get,
+ * A first): the newest-wins pick between a target and a depth buffer at one address (sink_bind_textures), the
+ * target slots' LRU and the write-back's "written since" test (wb_stamp) read them. */
+static void eng_dtk_stamp(const u32* surf, u32 n) { for (u32 i = 0; i < n; i++) g.surfaces[surf[i]].stamp = ++s_surf_clock; }
+static void eng_dtk_line(char* b, size_t n)   /* the counters, for the "[draw fast]" lines (then reset) */
+{
+    if (s_dtk <= 0) { if (n) b[0] = 0; return; }   /* off: the lines keep their old bytes */
+    snprintf(b, n, "; keyfix: replays rejected ucp %u vtex %u texunits %u xregs %u caster %u, not templates vtex %u"
+                   " dbnocopy %u zself %u light %u, dropped by address %u",
+             s_dtk_n[DTK_UCP], s_dtk_n[DTK_VTEX], s_dtk_n[DTK_TEXU], s_dtk_n[DTK_XREG], s_dtk_n[DTK_CT], s_dtk_n[DTK_I_VTEX],
+             s_dtk_n[DTK_I_DBP], s_dtk_n[DTK_I_ZSELF], s_dtk_n[DTK_I_LIGHT], s_dtk_n[DTK_D_ADDR]);
+    memset(s_dtk_n, 0, sizeof s_dtk_n);
+}
+/* TDX_BEGIN ---- dt texdelta (PS3_ENG_DT_TEXDELTA; work/agent_texdelta/NOTES.md) ---------------------------------------
+ * A draw that misses the draw-fast template (s_dt) or every draw-fast-N slot ONLY in the texture registers of units the
+ * template binds (tex_mask = enabled units the fragment program reads; programs, layout, render state, surface,
+ * viewport, the extra registers, the dt keyfix fields, the units outside tex_mask and the live targets all equal) is
+ * replayed with the template's pipeline and recorded state after re-resolving just the changed units, and the template
+ * keeps the new units (the next draw with these textures hits normally). Each changed unit must be, before and after,
+ * a plain texture-cache texture: the template's handle is held by the cache and is not "texhash dyn" (the N slots' vol
+ * rule), and nothing at the new address can catch it earlier in sink_bind_unit's order (no colour target with a handle,
+ * no depth buffer, not the GPU light / SSAO buffers); its pipeline-key inputs (cube / volume bit, gamma and sign-expand
+ * masks of candidate units, the shadow descriptor of sampled units) must equal the old unit's. The units are resolved
+ * by sink_bind_unit itself (the full path's per-unit body: cache lookup, LRU serial, per-frame hash, upload, texguard),
+ * and the result is refused (full path) unless every one came out of the cache as a held, non-dyn handle, the template
+ * survived (an eviction / release drops it: eng_tpl_forget), no handle was freed meanwhile (FREED_NOTE record), and no
+ * new handle equals another unit's handle for different texture registers.
+ * 0 / unset = off (one compare of a static on a texregs miss). 1 = on. 2 = verify: decide and resolve, keep a copy of
+ * what the replay would bind, take the full path and compare at its draw ("[dt texdelta] taken T ok O MISMATCH M").
+ * Read once with getenv at the first texregs miss (after main() filled the PS5 env). Off with
+ * PS3RECOMP_ENG_DRAW_FAST_VERIFY=1 (no replays there) and with PS3RECOMP_ENG_TPL_GUARD=0. */
+static int s_tdx = -1;
+enum { TDX_CAND, TDX_ELIG, TDX_REP, TDX_I_OLD, TDX_I_OFF, TDX_I_ADDR, TDX_I_PIPE,
+       TDX_L_CLASS, TDX_L_HANDLE, TDX_L_GONE, TDX_L_FREED, TDX_L_ALIAS, TDX_N };
+static unsigned s_tdx_n[TDX_N];
+static int eng_tdx_on(void)
+{
+    if (__builtin_expect(s_tdx < 0, 0)) {
+        const char* e = getenv("PS3_ENG_DT_TEXDELTA");
+        int m = e ? atoi(e) : 0;
+        if (m < 0 || m > 2) m = 0;
+        (void)eng_tg_on();   /* s_tpl_guard */
+        const char* off = !m ? NULL : s_dtm_verify ? "PS3RECOMP_ENG_DRAW_FAST_VERIFY=1" :
+                          !s_tpl_guard ? "PS3RECOMP_ENG_TPL_GUARD=0 (a re-resolve can release a handle a template binds)" : NULL;
+        if (off) { fprintf(stderr, "[dt texdelta] off: %s\n", off); m = 0; }
+        else if (m) fprintf(stderr, "[dt texdelta] mode %d (PS3_ENG_DT_TEXDELTA)%s\n", m,
+                            m == 2 ? ": decide and resolve, then run the full path and compare" : "");
+        s_tdx = m;
+    }
+    return s_tdx;
+}
+/* The template against the registers: 1 when only units of tex_mask differ (*chg = them); units of kmask outside
+ * tex_mask by eng_dtk_treg_cmp's rule, the dt keyfix fields as the caller's key compares them (xr: s_dt, not slots). */
+static int eng_tdx_cmp(const eng_dt_tpl* t, const eng_dtk_kx* kx, int xr, u32* chg)
+{
+    u32 c = 0;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!((t->kmask >> u) & 1u)) continue;
+        u32 w[9];
+        for (u32 k = 0; k < 8; k++) w[k] = rsx_dsp_reg(&g.rsx, 0x1A00u + u * 0x20u + k * 4u);
+        w[8] = rsx_dsp_reg(&g.rsx, 0x1840u + u * 4u);
+        if ((t->tex_mask >> u) & 1u) { if (memcmp(w, t->treg[u], sizeof w)) c |= 1u << u; continue; }
+        if ((t->treg[u][3] >> 31) ? memcmp(w, t->treg[u], sizeof w) != 0 : (w[3] >> 31) != 0) return 0;
+    }
+    if (!c || (eng_dtk_on() && eng_dtk_kx_cmp(kx, &t->kx, xr) >= 0)) return 0;
+    *chg = c;
+    return 1;
+}
+/* What eng_pipeline_get derives from one unit's nine words (rsx_dsp_get_texture's fields): the cube and volume mask
+ * bits (every enabled unit), the gamma / expand masks (candidate units), the shadow descriptor (sampled units). */
+typedef struct { u32 cube, vol, gamma, expand; rsx_fp_shadow_desc sh; } eng_tdx_sig;
+static void eng_tdx_sig_of(const u32 w[9], u32 u, const eng_fp_memo* fp, eng_tdx_sig* s)
+{
+    memset(s, 0, sizeof *s);
+    const u32 fmt = w[1], en = w[3] >> 31, cube = (fmt >> 2) & 1u, dim = (fmt >> 4) & 0xFu, format = (fmt >> 8) & 0xFFu;
+    const u32 wd = w[6] >> 16, ht = w[6] & 0xFFFFu, depth = w[8] >> 20;
+    s->cube = en && cube && wd && wd == ht;
+    s->vol = g.be->texture_create_3d && g.be->texture_upload_3d && en && !cube && dim == 3u && depth > 1u && wd && ht;
+    if (en && ((fp->gamma_cand >> u) & 1u)) s->gamma = rsx_texture_gamma_mask(format, w[4], w[5], w[2]);
+    if (en && ((fp->expand_cand >> u) & 1u)) s->expand = rsx_texture_expand_mask(format, w[4], w[5], w[2]);
+    if ((fp->sampled_units >> u) & 1u) rsx_fp_shadow_desc_from_texture(&s->sh, format, dim, cube, fmt >> 16, w[5], w[2], w[3]);
+}
+/* A handle the texture cache holds and does not hash at every draw (eng_dtm_record's vol rule). */
+static int eng_tdx_cache_handle(u32 h)
+{
+    if (!h || h >= ENG_OWNER_N || !s_tex_owner[h]) return 0;
+    const u32 vi = s_tex_owner[h] - 1u;
+    return vi < ENG_MAX_TEXTURES && g.textures[vi].handle == h && !g.textures[vi].th_dyn;
+}
+/* 1 when sink_bind_unit can only end in eng_texture_slot for a unit at (loc, off): every earlier branch needs a colour
+ * target with a handle there, a depth buffer there, or the GPU light / SSAO address (SSAO not yet set up: refused). */
+static int eng_tdx_addr_plain(u32 loc, u32 off)
+{
+    for (u32 i = 0; i < g.n_surfaces; i++)
+        if (g.surfaces[i].handle && g.surfaces[i].location == loc && g.surfaces[i].offset == off) return 0;
+    for (u32 i = 0; i < g.n_zdepths; i++)
+        if (g.zdepths[i].location == loc && g.zdepths[i].offset == off) return 0;
+    if (loc == RSX_LOCATION_MAIN && eng_gpu_light_on() && (off == s_gl.diff_off || off == s_gl.spec_off)) return 0;
+    if (loc == RSX_LOCATION_LOCAL && s_gs.on != 0 && (s_gs.on < 0 || off == s_gs.off)) return 0;
+    return 1;
+}
+/* mode 2: what the replay would have bound, compared at the full path's draw (eng_tdv_compare) */
+enum { TDV_TEX, TDV_SMP, TDV_MASK, TDV_PIPE, TDV_FP, TDV_XF, TDV_VPC, TDV_VP, TDV_SC, TDV_SREF, TDV_TGT, TDV_HUD, TDV_VTEX,
+       TDV_DBZ, TDV_DRAW, TDV_N };
+static const char* const s_tdv_name[TDV_N] = { "tex", "smp", "mask", "pipe", "fp", "xf", "vpc", "vp", "sc", "sref", "tgt",
+                                               "hud", "vtex", "dbz", "draw" };
+static eng_dt_tpl s_tdv_snap; static u32 s_tdv_serial, s_tdv_vbuf, s_tdv_nv, s_tdv_chg; static int s_tdv_slot;
+static const eng_im_entry* s_tdv_e;
+static unsigned s_tdv_taken, s_tdv_ok, s_tdv_bad, s_tdv_unver, s_tdv_first[TDV_N];
+/* tdfix: mode 2 also checks the template UPDATE mode 1 would make (s_tdv_snap; N slots: the near-match slot with the new
+ * units, s_tdv_ssnap) against what the full path then records (s_dt / the recorded slot): every field a later exact
+ * match compares or a replay binds. */
+static eng_dtm_slot s_tdv_ssnap; static u32 s_tdv_rserial; static int s_tdv_rn;
+static unsigned s_tdv_rok, s_tdv_rbad, s_tdv_rnone, s_tdv_rby[4];
+static int eng_tdx_key_eq(const u32* a, const u32* b)   /* the texture-cache key words: offset+location, format, remap, rect, pitch/depth */
+{
+    return a[0] == b[0] && a[1] == b[1] && a[4] == b[4] && a[6] == b[6] && a[8] == b[8];
+}
+/* The re-resolved units of a near-match, and putting them into a template (t itself, or a copy of t). */
+typedef struct { u32 chg; u32 tex[RSX_BE_MAX_TEXTURES]; rsx_be_sampler_desc smp[RSX_BE_MAX_TEXTURES]; u32 w[RSX_BE_MAX_TEXTURES][9]; } eng_tdx_res;
+static void eng_tdx_apply(eng_dt_tpl* d, const eng_tdx_res* r)
+{
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!((r->chg >> u) & 1u)) continue;
+        d->textures[u] = r->tex[u]; d->samplers[u] = r->smp[u]; memcpy(d->treg[u], r->w[u], sizeof r->w[u]);
+    }
+}
+/* A texregs-only near-match of template t (chg = its changed units). 1 = *r holds the re-resolved units: replay with
+ * them (mode 1); 0 = full path (mode 2 always: it keeps a copy of t with them for the compare). */
+static int eng_tdx_try(const eng_dt_tpl* t, u32 chg, int slot, u32 vbuf, u32 n_verts, const eng_im_entry* e, eng_tdx_res* r)
+{
+    if (s_tdv_serial) { s_tdv_unver++; s_tdv_serial = 0; }   /* the last checked draw never reached its draw */
+    if (s_tdv_rserial) { s_tdv_rnone++; s_tdv_rserial = 0; }   /* tdfix: ... nor a record */
+    s_tdx_n[TDX_CAND]++;
+    const eng_fp_memo* fp = t->fpm;   /* = the draw's (the caller compared the program memo entries) */
+    const u32 want = fp->gamma_cand | fp->expand_cand;
+    u32 (*w)[9] = r->w; u32* tex = r->tex; rsx_be_sampler_desc* smp = r->smp;
+    r->chg = chg;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!((chg >> u) & 1u)) continue;
+        for (u32 k = 0; k < 8; k++) w[u][k] = rsx_dsp_reg(&g.rsx, 0x1A00u + u * 0x20u + k * 4u);
+        w[u][8] = rsx_dsp_reg(&g.rsx, 0x1840u + u * 4u);
+        int why = -1;
+        if (!eng_tdx_cache_handle(t->textures[u])) why = TDX_I_OLD;
+        else if (!(w[u][3] >> 31)) why = TDX_I_OFF;   /* the full path would not bind it: another tex_mask */
+        else if (!eng_tdx_addr_plain(eng_dtk_uloc(w[u]), w[u][0])) why = TDX_I_ADDR;
+        else if (eng_tex_lite() && ((fp->sampled_units >> u) & 1u) && !((want >> u) & 1u))
+            why = TDX_I_PIPE;   /* eng tex lite decodes only candidate units: this one's shadow descriptor is not from its registers */
+        else {
+            eng_tdx_sig a, b; eng_tdx_sig_of(t->treg[u], u, fp, &a); eng_tdx_sig_of(w[u], u, fp, &b);
+            if (memcmp(&a, &b, sizeof a)) why = TDX_I_PIPE;
+        }
+        if (why >= 0) { s_tdx_n[why]++; return 0; }
+    }
+    s_tdx_n[TDX_ELIG]++;
+    memset(r->tex, 0, sizeof r->tex); memset(r->smp, 0, sizeof r->smp);   /* sink_bind_unit fills an empty unit */
+    const int bf = eng_bf_on(); const u32 f0 = bf ? rsx_be_freed_cursor() : 0u;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!((chg >> u) & 1u)) continue;
+        rsx_dsp_texture tt; rsx_dsp_get_texture(&g.rsx, u, &tt);
+        if (sink_bind_unit(u, &tt, t->surf, t->n_targets, t->zslot, tex, smp) != ENG_TB_PLAIN) { s_tdx_n[TDX_L_CLASS]++; return 0; }
+    }
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++)   /* after all: a later unit's upload may have evicted an earlier one's */
+        if (((chg >> u) & 1u) && !eng_tdx_cache_handle(tex[u])) { s_tdx_n[TDX_L_HANDLE]++; return 0; }
+    if (!t->valid) { s_tdx_n[TDX_L_GONE]++; return 0; }   /* eng_tpl_forget: a handle it binds was released */
+    if (bf && rsx_be_freed_cursor() != f0) { s_tdx_n[TDX_L_FREED]++; return 0; }
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (!((chg >> u) & 1u)) continue;
+        for (u32 v = 0; v < RSX_BE_MAX_TEXTURES; v++) {
+            if (v == u || !((t->tex_mask >> v) & 1u)) continue;
+            const u32 hv = ((chg >> v) & 1u) ? tex[v] : t->textures[v];
+            const u32* rv = ((chg >> v) & 1u) ? w[v] : t->treg[v];
+            if (hv == tex[u] && !eng_tdx_key_eq(rv, w[u])) { s_tdx_n[TDX_L_ALIAS]++; return 0; }   /* the number of a freed object */
+        }
+    }
+    if (s_tdx == 2) {
+        s_tdv_snap = *t; eng_tdx_apply(&s_tdv_snap, r);
+        s_tdv_serial = s_draw_serial; s_tdv_slot = slot; s_tdv_chg = chg; s_tdv_vbuf = vbuf; s_tdv_nv = n_verts; s_tdv_e = e;
+        s_tdv_rserial = s_draw_serial;   /* tdfix */
+        if (slot >= 0) { s_tdv_ssnap = s_dtm[slot]; s_tdv_ssnap.t = s_tdv_snap; }
+        s_tdv_taken++;
+        return 0;
+    }
+    s_tdx_n[TDX_REP]++;
+    return 1;
+}
+/* mode 2, at the full path's draw: its binds against the copy */
+static __attribute__((noinline, cold)) void eng_tdv_compare(u32 pipeline, const u32* handles, u32 n_targets, u32 depth_handle,
+    const float* xf, int vpc_range, u32 fp_bytes, const u32* textures, const rsx_be_sampler_desc* samplers, u32 tex_mask,
+    u32 vtex_mask, u32 target, float W, float H, u32 vbuf, u32 n_verts, u32 stride, int indexed, u32 n_draw,
+    const u32* draw_idx, int rie)
+{
+    const eng_dt_tpl* o = &s_tdv_snap;
+    s_tdv_serial = 0;
+    u32 bad = 0;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) if ((tex_mask >> u) & 1u) {
+        if (o->textures[u] != textures[u]) bad |= 1u << TDV_TEX;
+        if (memcmp(&o->samplers[u], &samplers[u], sizeof samplers[u])) bad |= 1u << TDV_SMP; }
+    if (o->tex_mask != tex_mask) bad |= 1u << TDV_MASK;
+    if (o->pipeline != pipeline) bad |= 1u << TDV_PIPE;
+    if (o->fp_bytes != fp_bytes || memcmp(o->fp_cb, g.fp_cb, fp_bytes)) bad |= 1u << TDV_FP;
+    if (memcmp(o->xf, xf, sizeof o->xf)) bad |= 1u << TDV_XF;
+    if (!vpc_range || o->vpc_lo != g.vpc_lo || o->vpc_n != g.vpc_n) bad |= 1u << TDV_VPC;
+    if (o->W != W || o->H != H) bad |= 1u << TDV_VP;
+    if (memcmp(o->sc, s_ct_sc, sizeof o->sc)) bad |= 1u << TDV_SC;
+    if (o->sref != (rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF) & 0xFFu)) bad |= 1u << TDV_SREF;
+    if (o->n_targets != n_targets || o->depth_handle != depth_handle || memcmp(o->handles, handles, sizeof(u32) * n_targets))
+        bad |= 1u << TDV_TGT;
+    if (g.be->set_hud && (o->hud != s_ct_hud || o->hud_w != g.surfaces[target].w)) bad |= 1u << TDV_HUD;
+    if (vtex_mask) bad |= 1u << TDV_VTEX;   /* the replay binds no vertex unit */
+    if (s_dbz.unit) bad |= 1u << TDV_DBZ;   /* nor the depth-bounds copy */
+    if (s_tdv_vbuf != vbuf || s_tdv_nv != n_verts || o->stride != stride || !indexed || rie || !s_tdv_e ||
+        s_tdv_e != dc.im_hit || draw_idx != s_tdv_e->idx || s_tdv_e->n_draw != n_draw) bad |= 1u << TDV_DRAW;
+    if (!bad) { s_tdv_ok++; return; }
+    s_tdv_bad++; s_tdv_first[__builtin_ctz(bad)]++;
+    static int lg;
+    if (lg++ < 8) {
+        u32 du = 99; for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) if (((tex_mask >> u) & 1u) && o->textures[u] != textures[u]) { du = u; break; }
+        char cl[160]; int n = 0; cl[0] = 0;
+        for (u32 k = 0; k < TDV_N && n < (int)sizeof cl - 8; k++) if ((bad >> k) & 1u) n += snprintf(cl + n, sizeof cl - n, " %s", s_tdv_name[k]);
+        fprintf(stderr, "[dt texdelta] MISMATCH frame %u draw %u %s %d changed units 0x%04X:%s; fp %016llx pipe %u -> %u, mask 0x%04X -> 0x%04X,"
+                        " first tex unit %u (%u -> %u), fp bytes %u -> %u, vbuf %u -> %u\n",
+                g.frames, g.guest_draws, s_tdv_slot < 0 ? "template" : "slot", s_tdv_slot, s_tdv_chg, cl, (unsigned long long)o->fps_,
+                o->pipeline, pipeline, o->tex_mask, tex_mask, du, du < 16 ? o->textures[du] : 0u, du < 16 ? textures[du] : 0u,
+                o->fp_bytes, fp_bytes, s_tdv_vbuf, vbuf);
+    }
+}
+/* tdfix, mode 2: the full path's record r (slot rs, NULL = s_dt) against the update mode 1 would have made. Classes:
+ * 0 key (state, programs, topology / stride / prim), 1 texture key (tex_mask, kmask, treg, kx), 2 binds, 3 slot fields. */
+static __attribute__((noinline, cold)) void eng_tdv_reccheck(const eng_dt_tpl* r, const eng_dtm_slot* rs)
+{
+    const eng_dt_tpl* o = &s_tdv_snap;
+    s_tdv_rserial = 0;
+    u32 bad = 0;
+    if (memcmp(&o->rs, &r->rs, sizeof r->rs) || memcmp(&o->sf, &r->sf, sizeof r->sf) || memcmp(&o->vp, &r->vp, sizeof r->vp) ||
+        memcmp(o->regs, r->regs, sizeof r->regs) || o->vpm != r->vpm || o->fpm != r->fpm || o->vph != r->vph ||
+        o->fps_ != r->fps_ || o->vstart != r->vstart || o->vinstrs != r->vinstrs || o->floc != r->floc || o->foff != r->foff ||
+        o->fsize != r->fsize || o->topology != r->topology || o->stride != r->stride || o->prim != r->prim) bad |= 1u;
+    if (o->tex_mask != r->tex_mask || o->kmask != r->kmask || (eng_dtk_on() && memcmp(&o->kx, &r->kx, sizeof r->kx))) bad |= 2u;
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) {
+        if (((r->kmask >> u) & 1u) && memcmp(o->treg[u], r->treg[u], sizeof r->treg[u])) bad |= 2u;
+        if (((r->tex_mask >> u) & 1u) && (o->textures[u] != r->textures[u] || memcmp(&o->samplers[u], &r->samplers[u], sizeof r->samplers[u])))
+            bad |= 4u;
+    }
+    if (o->pipeline != r->pipeline || o->n_targets != r->n_targets || o->depth_handle != r->depth_handle || o->zslot != r->zslot ||
+        memcmp(o->xf, r->xf, sizeof r->xf) || o->vpc_lo != r->vpc_lo || o->vpc_n != r->vpc_n || o->fp_bytes != r->fp_bytes ||
+        o->hud != r->hud || o->hud_w != r->hud_w || o->W != r->W || o->H != r->H || memcmp(o->sc, r->sc, sizeof r->sc) || o->sref != r->sref)
+        bad |= 4u;
+    else if (memcmp(o->fp_cb, r->fp_cb, r->fp_bytes)) bad |= 4u;
+    for (u32 k = 0; !(bad & 4u) && k < r->n_targets && k < RSX_BE_MAX_COLOR_TARGETS; k++)
+        if (o->handles[k] != r->handles[k] || o->surf[k] != r->surf[k]) bad |= 4u;
+    if (rs) {
+        const eng_dtm_slot* os = &s_tdv_ssnap;
+        if (os->fgen != rs->fgen || os->lmask != rs->lmask || memcmp(os->xr, rs->xr, sizeof rs->xr) || os->vol != rs->vol || os->ns != rs->ns)
+            bad |= 8u;
+        for (u32 j = 0; !(bad & 8u) && j < rs->ns && j < ENG_DTN_ST; j++)
+            if (os->sid[j] != rs->sid[j] || os->sst[j] != rs->sst[j]) bad |= 8u;
+    }
+    if (!bad) { s_tdv_rok++; return; }
+    s_tdv_rbad++; s_tdv_rby[__builtin_ctz(bad)]++;
+    if (s_tdv_rn++ < 8)
+        fprintf(stderr, "[dt texdelta] UPDATE DIFF frame %u draw %u %s %d changed units 0x%04X: classes 0x%X (1 key 2 texkey 4 binds 8 slot);"
+                        " tex_mask 0x%04X -> 0x%04X, kmask 0x%04X -> 0x%04X, pipe %u -> %u, vol %d -> %d\n",
+                g.frames, g.guest_draws, s_tdv_slot < 0 ? "template" : "slot", s_tdv_slot, s_tdv_chg, bad, o->tex_mask, r->tex_mask,
+                o->kmask, r->kmask, o->pipeline, r->pipeline, rs ? s_tdv_ssnap.vol : -1, rs ? rs->vol : -1);
+}
+static void eng_tdx_frame_end(void)   /* once per present */
+{
+    static u32 n;
+    if (s_tdx <= 0) return;
+    if (s_tdv_serial) { s_tdv_unver++; s_tdv_serial = 0; }
+    if (s_tdv_rserial) { s_tdv_rnone++; s_tdv_rserial = 0; }   /* tdfix */
+    if (++n < 300u) return;
+    n = 0;
+    const unsigned* c = s_tdx_n;
+    fprintf(stderr, "[dt texdelta] mode %d: last 300 frames: per frame %.1f texregs-only, %.1f eligible, %.1f %s; not eligible:"
+                    " old unit not plain %u, unit off %u, target/depth/light address %u, pipeline bits %u; refused after resolve:"
+                    " not plain %u, handle %u, template dropped %u, freed %u, alias %u\n",
+            s_tdx, c[TDX_CAND] / 300.0, c[TDX_ELIG] / 300.0, (s_tdx == 2 ? s_tdv_taken : c[TDX_REP]) / 300.0,
+            s_tdx == 2 ? "taken (would replay)" : "replayed", c[TDX_I_OLD], c[TDX_I_OFF], c[TDX_I_ADDR], c[TDX_I_PIPE],
+            c[TDX_L_CLASS], c[TDX_L_HANDLE], c[TDX_L_GONE], c[TDX_L_FREED], c[TDX_L_ALIAS]);
+    if (s_tdx == 2) {
+        char fl[320]; int k = 0; fl[0] = 0;
+        for (u32 i = 0; i < TDV_N && k < (int)sizeof fl - 24; i++) k += snprintf(fl + k, sizeof fl - k, "%s%s %u", i ? " " : "", s_tdv_name[i], s_tdv_first[i]);
+        fprintf(stderr, "[dt texdelta] taken %u ok %u MISMATCH %u (first-diff classes %s), unverified %u\n",
+                s_tdv_taken, s_tdv_ok, s_tdv_bad, fl, s_tdv_unver);
+        fprintf(stderr, "[dt texdelta] update check: ok %u DIFF %u (first-diff classes key %u texkey %u binds %u slot %u), no record %u\n",
+                s_tdv_rok, s_tdv_rbad, s_tdv_rby[0], s_tdv_rby[1], s_tdv_rby[2], s_tdv_rby[3], s_tdv_rnone);   /* tdfix */
+        s_tdv_rok = s_tdv_rbad = s_tdv_rnone = 0; memset(s_tdv_rby, 0, sizeof s_tdv_rby);
+        s_tdv_taken = s_tdv_ok = s_tdv_bad = s_tdv_unver = 0; memset(s_tdv_first, 0, sizeof s_tdv_first);
+    }
+    memset(s_tdx_n, 0, sizeof s_tdx_n);
+}
+/* TDX_END */
+static int eng_dt_replay(rsx_topology topology, u32 vbuf, u32 n_verts, eng_im_entry* e)   /* ba idx ref: e not const (idx_tk) */
+{
+    /* eng dirty: the register-derived inputs (render state, surface, viewport, the 8 extra registers and
+     * the bound units' texture registers) are pure functions of g.rsx.regs[] plus the three cull-flip
+     * switches snapshotted in k. Once they compared equal to the template, they stay equal until a
+     * non-neutral register changes value or the template is rewritten (both set g_rsx_dsp_dirty bit1). The
+     * programs, depth slot and target handles are not register-derived and are compared on every draw. */
+    static struct { int ok, ccf, zon; u32 zz; } k;
+    rsx_be_render_state frs; rsx_dsp_surface fsf; rsx_dsp_viewport fvp; u32 fr[8];
+    const rsx_be_render_state* prs = &frs; const rsx_dsp_surface* psf = &fsf; const rsx_dsp_viewport* pvp = &fvp;
+    const eng_vp_memo* fvm = NULL; const eng_fp_memo* ffm = NULL;
+    int tdx = 0;   /* dt texdelta: 1 = a bound unit's registers differ, 2 = replayed with re-resolved units */
+    eng_guest_programs(&fvm, &ffm);
+    int same = fvm == s_dt.vpm && ffm == s_dt.fpm && fvm && ffm &&
+               fvm->hash == s_dt.vph && fvm->start == s_dt.vstart && fvm->instrs == s_dt.vinstrs &&
+               ffm->structural == s_dt.fps_ && ffm->loc == s_dt.floc && ffm->off == s_dt.foff && ffm->size == s_dt.fsize &&
+               s_dt.zslot < g.n_zdepths && g.zdepths[s_dt.zslot].handle == s_dt.depth_handle && g.zdepths[s_dt.zslot].cleared;
+    for (u32 i = 0; same && i < s_dt.n_targets; i++) same = g.surfaces[s_dt.surf[i]].handle == s_dt.handles[i];
+    const int dirty_on = eng_dirty_on();
+    const int clean = dirty_on && k.ok && !(g_rsx_dsp_dirty & 2u) &&
+                      k.ccf == __atomic_load_n(&s_clamp_cull_flip, __ATOMIC_RELAXED) &&
+                      k.zon == __atomic_load_n(&s_zflip_on, __ATOMIC_RELAXED) && k.zz == s_zflip_zeta;
+    if (clean && !s_eng_dirty_chk) {
+        if (!same) return 0;
+        prs = &s_dt.rs; psf = &s_dt.sf; pvp = &s_dt.vp;   /* equal to what a decode would give */
+    } else {
+        memset(&fsf, 0, sizeof fsf); memset(&fvp, 0, sizeof fvp);
+        rsx_draw_engine_decode_render_state(&g.rsx, &frs);
+        rsx_dsp_get_surface(&g.rsx, &fsf);
+        rsx_dsp_get_viewport(&g.rsx, &fvp);
+        eng_ct_regs(fr);
+        int rsame = !memcmp(&frs, &s_dt.rs, sizeof frs) &&
+                    !memcmp(&fsf, &s_dt.sf, sizeof fsf) && !memcmp(&fvp, &s_dt.vp, sizeof fvp) && !memcmp(fr, s_dt.regs, sizeof fr);
+        if (rsame && (same || dirty_on)) {
+            const int tc = eng_dtk_treg_cmp(s_dt.tex_mask, s_dt.kmask, s_dt.treg);   /* dt keyfix A3: 2 = a unit outside tex_mask */
+            if (tc == 1 && same && __builtin_expect(s_tdx != 0, 0) && eng_tdx_on()) tdx = 1;   /* a bound unit differs */
+            int kf = tc == 2 ? DTK_TEXU : -1;
+            if (!tc && eng_dtk_on()) { eng_dtk_kx kx; eng_dtk_kx_now(&kx); kf = eng_dtk_kx_cmp(&kx, &s_dt.kx, 1); }   /* A1 A2 A5 */
+            rsame = !tc && kf < 0;
+            if (kf >= 0 && same) s_dtk_n[kf]++;   /* the old key would have replayed it */
+        }
+        if (clean && !rsame) eng_dirty_miss(1, "draw-fast register state", s_dt.tex_mask, s_dt.pipeline);
+        if (s_eng_dirty_chk >= 2) {   /* eng dirty verify */
+            s_dv_tries++;
+            if (clean) { s_dv_clean[1]++; eng_dv_regs(); }
+            eng_dv_report();
+        }
+        if (dirty_on) {
+            k.ok = rsame;
+            if (rsame) {
+                k.ccf = __atomic_load_n(&s_clamp_cull_flip, __ATOMIC_RELAXED);
+                k.zon = __atomic_load_n(&s_zflip_on, __ATOMIC_RELAXED); k.zz = s_zflip_zeta;
+                g_rsx_dsp_dirty &= ~2u;
+                if (s_eng_dirty_chk >= 2 && !clean) eng_dv_snap();   /* eng dirty verify: the clean epoch's baseline */
+            }
+        }
+        if (__builtin_expect(tdx, 0)) {   /* dt texdelta: only bound units' registers differ? (k.ok stays 0: the next draw decodes) */
+            eng_dtk_kx kx; memset(&kx, 0, sizeof kx); u32 chg = 0; eng_tdx_res res;
+            if (eng_dtk_on()) eng_dtk_kx_now(&kx);
+            if (eng_tdx_cmp(&s_dt, &kx, 1, &chg) && eng_tdx_try(&s_dt, chg, -1, vbuf, n_verts, e, &res)) {
+                eng_tdx_apply(&s_dt, &res);   /* the template keeps them */
+                rsame = 1; tdx = 2;
+                g_rsx_dsp_dirty |= 2u;   /* eng dirty: the template changed, the next replay compares in full */
+            }
+        }
+        if (!same || !rsame) return 0;
+    }
+    if (__builtin_expect(s_eng_ro, 0)) ENG_RO_BINDS(s_dt, -1, NULL, NULL, 0u, psf->zeta_offset, prs, pvp->scale[1], tdx == 2);   /* ba replay op */
+    else {
+    g.be->bind_targets(g.be->user, s_dt.handles, s_dt.n_targets, s_dt.depth_handle);
+    g.be->bind_pipeline(g.be->user, s_dt.pipeline);
+    g.be->bind_vs_constants_range(g.be->user, g.rsx.constants, s_dt.vpc_lo, s_dt.vpc_n,
+                                  s_dt.xf, sizeof s_dt.xf, ENG_VP_CB_BYTES);
+    g.be->bind_ps_constants(g.be->user, s_dt.fp_cb, s_dt.fp_bytes);
+    g.be->bind_textures(g.be->user, s_dt.textures, s_dt.samplers, s_dt.tex_mask);
+    { u32 vt[RSX_BE_MAX_VERTEX_TEXTURES] = { 0 }; rsx_be_sampler_desc vs[RSX_BE_MAX_VERTEX_TEXTURES];
+      memset(vs, 0, sizeof vs); g.be->bind_vertex_textures(g.be->user, vt, vs, 0); }
+    if (g.be->set_hud) g.be->set_hud(g.be->user, s_dt.hud, s_dt.hud_w);
+    g.be->set_viewport(g.be->user, 0.0f, 0.0f, s_dt.W, s_dt.H);
+    g.be->set_scissor(g.be->user, s_dt.sc[0], s_dt.sc[1], s_dt.sc[2], s_dt.sc[3]);
+    g.be->set_stencil_ref(g.be->user, s_dt.sref);
+    eng_apply_depth_bias(psf->zeta_offset, prs, s_dt.n_targets);
+    eng_apply_depth_clip(psf->zeta_offset, prs, pvp->scale[1]);
+    }
+    if (eng_dtk_on()) eng_dtk_stamp(s_dt.surf, s_dt.n_targets);   /* dt keyfix A9 */
+    eng_draw_vbuf_memo(topology, vbuf, n_verts, s_dt.stride, e);   /* ba idx ref */
+    g.guest_draws++;
+    if (s_pl_on) eng_pl_note(1, 0);   /* eng passlog */
+    if (prs->depth_test && prs->depth_write) {
+        eng_zdepth* z = &g.zdepths[s_dt.zslot];
+        z->had_write = 1; z->stamp = ++s_surf_clock;
+        z->snapshot_valid = 0; z->crop_z_valid = 0; z->snapshot_rgba_valid = 0; z->crop_valid = 0;
+    } else if (s_dt.zslot < g.n_zdepths && eng_stencil_writes(prs)) {   /* eng stencil (prs: frs is not decoded on the clean path) */
+        eng_zdepth* z = &g.zdepths[s_dt.zslot];
+        z->snapshot_rgba_valid = 0; z->crop_valid = 0;
+    }
+    s_dt_fast++;
+    return 1;
+}
+
+/* eng draw fast N: the register-derived replay inputs, decoded once per dirty epoch (eng dirty on) or per draw. */
+static void eng_dtm_decode(void)
+{
+    const int dirty_on = eng_dirty_on();
+    const int ccf = __atomic_load_n(&s_clamp_cull_flip, __ATOMIC_RELAXED), zon = __atomic_load_n(&s_zflip_on, __ATOMIC_RELAXED);
+    const int clean = dirty_on && s_dtm_dec.ok && !(g_rsx_dsp_dirty & 2u) &&
+                      s_dtm_dec.ccf == ccf && s_dtm_dec.zon == zon && s_dtm_dec.zz == s_zflip_zeta;
+    if (clean && !s_eng_dirty_chk) return;   /* the registers are as at the last decode: it and the slots' verdicts stand */
+    rsx_be_render_state frs; rsx_dsp_surface fsf; rsx_dsp_viewport fvp; u32 fr[8], fx[5];
+    eng_dtk_kx kx; memset(&kx, 0, sizeof kx);   /* dt keyfix */
+    memset(&fsf, 0, sizeof fsf); memset(&fvp, 0, sizeof fvp);
+    rsx_draw_engine_decode_render_state(&g.rsx, &frs);
+    rsx_dsp_get_surface(&g.rsx, &fsf);
+    rsx_dsp_get_viewport(&g.rsx, &fvp);
+    eng_ct_regs(fr); eng_dtm_xregs(fx);
+    if (eng_dtk_on()) eng_dtk_kx_now(&kx);
+    if (s_eng_dirty_chk >= 2) {   /* perfstack: eng dirty verify (CHECK=2) covers the N-slot path too */
+        s_dv_tries++;
+        if (clean) { s_dv_clean[1]++; eng_dv_regs(); }
+        eng_dv_report();
+    }
+    if (clean) {   /* PS3_ENG_DIRTY_CHECK */
+        if (memcmp(&frs, &s_dtm_dec.rs, sizeof frs) || memcmp(&fsf, &s_dtm_dec.sf, sizeof fsf) ||
+            memcmp(&fvp, &s_dtm_dec.vp, sizeof fvp) || memcmp(fr, s_dtm_dec.regs, sizeof fr) || memcmp(fx, s_dtm_dec.xr, sizeof fx) ||
+            memcmp(&kx, &s_dtm_dec.kx, sizeof kx))
+            eng_dirty_miss(1, "draw-fast N register state", 0, 0);   /* CHECK=1: abort; CHECK=2: count, then take the decode */
+        else return;
+    }
+    s_dtm_dec.rs = frs; s_dtm_dec.sf = fsf; s_dtm_dec.vp = fvp; memcpy(s_dtm_dec.regs, fr, sizeof fr); memcpy(s_dtm_dec.xr, fx, sizeof fx);
+    s_dtm_dec.kx = kx;
+    s_dtm_dec.ok = 1; s_dtm_dec.ccf = ccf; s_dtm_dec.zon = zon; s_dtm_dec.zz = s_zflip_zeta;
+    if (++s_dtm_ep == 0) s_dtm_ep = 1;   /* every slot's verdict is unknown again */
+    if (dirty_on) g_rsx_dsp_dirty &= ~2u;
+    if (s_eng_dirty_chk >= 2) eng_dv_snap();   /* perfstack: eng dirty verify, the clean epoch's baseline */
+}
+/* Does slot s's register state equal the current one? (s_dtm_dec is current.) */
+static int eng_dtm_regs_equal(eng_dtm_slot* s, int* tex_only)
+{
+    int known = -1;
+    if (s->eq_ep == s_dtm_ep) known = 1; else if (s->ne_ep == s_dtm_ep) known = 0;
+    if (known >= 0 && !s_eng_dirty_chk) { *tex_only = known ? 0 : s->ne_tex; return known; }   /* (ne_tex: 0, 1 or 2 + DTK_x) */
+    const eng_dt_tpl* t = &s->t;
+    int eq = !memcmp(&s_dtm_dec.rs, &t->rs, sizeof t->rs) && !memcmp(&s_dtm_dec.sf, &t->sf, sizeof t->sf) &&
+             !memcmp(&s_dtm_dec.vp, &t->vp, sizeof t->vp) && !memcmp(s_dtm_dec.regs, t->regs, sizeof t->regs) &&
+             !memcmp(s_dtm_dec.xr, s->xr, sizeof s->xr);
+    int tex = 0;   /* 1 texture registers, 2 + DTK_x a dt keyfix field */
+    if (eq) {
+        const int tc = eng_dtk_treg_cmp(t->tex_mask, t->kmask, t->treg);
+        if (tc) { eq = 0; tex = tc == 1 ? 1 : 2 + DTK_TEXU; }
+        else if (eng_dtk_on()) { const int kf = eng_dtk_kx_cmp(&s_dtm_dec.kx, &t->kx, 0); if (kf >= 0) { eq = 0; tex = 2 + kf; } }
+    }
+    if (known >= 0 && known != eq) eng_dirty_miss(1, "draw-fast N slot verdict", (u32)known, (u32)eq);   /* perfstack: CHECK=2 counts */
+    if (eq) s->eq_ep = s_dtm_ep; else { s->ne_ep = s_dtm_ep; s->ne_tex = tex; }
+    *tex_only = tex;
+    return eq;
+}
+/* dt verify (debug), N slots: the slot a would-be replay matched, compared on the full path with what it computes. */
+static eng_dt_tpl s_dtv_snap; static u32 s_dtv_serial; static int s_dtv_slot, s_dtv_vol;
+static unsigned long long s_dtv_ok, s_dtv_bad, s_dtv_bad_vol, s_dtv_by[17], s_dtv_unver, s_dtv_n3wb, s_dtv_n3z;
+static void eng_dtv_compare(const eng_dt_tpl* now)
+{
+    const eng_dt_tpl* o = &s_dtv_snap;
+    int bad = 0;
+#define DTV(i, cond) do { if (cond) { bad |= 1 << (i); s_dtv_by[i]++; } } while (0)
+    DTV(0, memcmp(o->xf, now->xf, sizeof o->xf));
+    DTV(1, o->fp_bytes != now->fp_bytes || memcmp(o->fp_cb, now->fp_cb, now->fp_bytes));
+    DTV(2, o->tex_mask != now->tex_mask);
+    for (u32 u = 0; u < RSX_BE_MAX_TEXTURES; u++) if ((now->tex_mask >> u) & 1u) {
+        DTV(3, o->textures[u] != now->textures[u]);
+        DTV(4, memcmp(&o->samplers[u], &now->samplers[u], sizeof o->samplers[u])); }
+    DTV(5, memcmp(o->sc, now->sc, sizeof o->sc) || o->W != now->W || o->H != now->H);
+    DTV(6, o->sref != now->sref);
+    DTV(7, o->pipeline != now->pipeline || o->stride != now->stride);
+    DTV(8, o->n_targets != now->n_targets || o->depth_handle != now->depth_handle || o->zslot != now->zslot ||
+           memcmp(o->handles, now->handles, sizeof(o->handles[0]) * now->n_targets));
