+        return;
+    }
+    s_oq.lq_w = (li + 1u) % VK_OQ_LOG;
+    memset(&s_oq.lq[li], 0, sizeof s_oq.lq[li]);
+    s_oq.lq[li].id = id; s_oq.lq[li].used = 1; s_oq.lq[li].born = s_oq.presents;
+    s_oq.want = id; s_oq.cur_lq = (int)li; s_oq.st_ids++;
+}
