+/* BFR_BEGIN (harness extract) */
+/* t35b (F1): a draw's texture units were resolved while the backend freed something (end of the record moved past
+ * c0, the cursor right after the draw-start read). A copy request for one unit -- a depth->RGBA8 cache eviction, a
+ * depth-copy eviction, a snap2 resize -- can free the copy an earlier unit of the same draw took from the engine's
+ * cache, and the new copy usually gets that number back; eng_tg_new reads the record before storing the new copy, so a
+ * plain read here saw nothing (t35_01) and the earlier unit sampled the new copy. eng_bf_scan looks at [c0, end) without
+ * consuming it and compares each free with the position each unit settled at. Freed units: read the record to its end
+ * (forgets every cache still naming a freed number; on an overflow everything), then resolve all units again, which
+ * asks the backend again for exactly the forgotten ones. At most ENG_BF_PASSES resolutions in all; a draw still naming
+ * a freed handle after that is counted (stale) and drawn as before. Vertex units take only guest textures (the texture
+ * cache: never freed by the backend on its own, and an LRU entry this draw used is the newest), so they cannot be the
+ * evicted unit; they are scanned anyway, and re-resolved with the rest. Cold, out of line: sink_end keeps its shape. */
+#define ENG_BF_PASSES 3u
+static __attribute__((noinline, cold)) void eng_bf_recheck(u32 c0, const u32* targets, u32 n_targets, u32 zslot,
+                                                           const rsx_be_render_state* rs, u32 target, u32 n_verts,
+                                                           u32 textures[RSX_BE_MAX_TEXTURES],
+                                                           rsx_be_sampler_desc samplers[RSX_BE_MAX_TEXTURES], u32* tex_mask,
+                                                           u32 vtex_want, u32 vtextures[RSX_BE_MAX_VERTEX_TEXTURES],
+                                                           rsx_be_sampler_desc vsamplers[RSX_BE_MAX_VERTEX_TEXTURES],
+                                                           u32* vtex_mask)
+{
+    for (u32 pass = 1;; pass++) {
+        u32 fs = eng_bf_scan(c0, textures, *tex_mask, s_bf_upos, RSX_BE_MAX_TEXTURES);
+        u32 vs = fs == ENG_BF_SCAN_LOST ? 0u : eng_bf_scan(c0, vtextures, *vtex_mask, s_bf_vpos, RSX_BE_MAX_VERTEX_TEXTURES);
+        const int lost = fs == ENG_BF_SCAN_LOST || vs == ENG_BF_SCAN_LOST;
+        if (lost) { fs = *tex_mask; vs = *vtex_mask; }
+        if (!fs && !vs) return;
+        if (pass >= ENG_BF_PASSES) {
+            s_tg_bf_stale++;
+            { static unsigned n; if (n++ < 8)
+                fprintf(stderr, "[texguard] draw still names a freed handle after %u resolutions: units 0x%04X, vertex units 0x%X"
+                                " (drawn as is)\n", pass, fs, vs); }
+            return;
+        }
+        if (pass == 1) s_tg_bf_rebind++;
+        s_tg_bf_units += (unsigned)__builtin_popcount(fs) + (unsigned)__builtin_popcount(vs);
+        { static unsigned n; if (n++ < 8) {
+            int u0 = fs ? __builtin_ctz(fs) : -1;
+            fprintf(stderr, "[texguard] frame %u: units 0x%04X (vertex 0x%X) were freed after this draw resolved them%s"
+                            " (unit %d had handle %u): resolved again\n", g.frames, fs, vs, lost ? " (record overflow)" : "",
+                    u0, u0 >= 0 ? textures[u0] : 0u); } }
+        if (lost) {   /* counted unless a record read since c0 already counted it */
+            if ((int32_t)(s_bf_lost_at - c0) <= 0) { s_tg_bf_lost++; s_bf_lost_at = rsx_be_freed_cursor(); }
+            eng_bf_flush();
+        }
+        (void)eng_bf_drain(NULL, 0);
+        c0 = s_bf_cur;
+        memset(textures, 0, sizeof(u32) * RSX_BE_MAX_TEXTURES);
+        memset(samplers, 0, sizeof(rsx_be_sampler_desc) * RSX_BE_MAX_TEXTURES);
+        memset(vtextures, 0, sizeof(u32) * RSX_BE_MAX_VERTEX_TEXTURES);
+        memset(vsamplers, 0, sizeof(rsx_be_sampler_desc) * RSX_BE_MAX_VERTEX_TEXTURES);
+        *tex_mask = sink_bind_textures(targets, n_targets, zslot, textures, samplers);
+        *tex_mask = eng_depth_bounds_prepare(zslot, rs, target, n_verts, *tex_mask, textures, samplers);
+        *vtex_mask = sink_bind_vertex_textures(vtex_want, vtextures, vsamplers);
+    }
+}
+/* BFR_END */
+
+/* FS_BEGIN (harness extract) ---- dt fetchskip (PS3RECOMP_ENG_DT_FETCHSKIP; work/agent_fetchskip/NOTES.md) ----------
+ * A draw that the single draw-fast template replays still decodes its vertex layout, builds and prepares a fetch
+ * plan and probes the vertex cache before the replay gate, only to learn "same persistent buffer as before". For a
+ * depth-only position-only draw (depth test + write on, no colour target or colour mask 0, vertex program input mask
+ * = attribute 0 alone, fragment program samples no unit) that hit the idx memo, a small direct-mapped memo (by idx
+ * memo entry) remembers which vertex-cache entry those steps ended in, keyed by every input of that entry's key
+ * (VTXBUF_OFFSET[0] 0x1680, VTXFMT[0] 0x1740, VERTEX_DATA_BASE_OFFSET 0x1738, _INDEX 0x173C, FREQUENCY_DIVIDER 0x1FC0
+ * compared raw -- eng dirty does not mark the first four --, the vertex program, the idx entry's range, attribute 0's
+ * host span pointer recomputed as prepare_ex does, the cache generation). The steps are skipped only when, in
+ * addition, the entry passes eng_vc_entry_checked_this_frame -- the probe's own "already checked this frame" early
+ * return -- and dc_fetch's hit test: then the probe would return this entry without hashing and dc_fetch would hand
+ * over this buffer, so the skip reuses nothing the normal path would have refreshed. The first use of a buffer in a
+ * frame always takes the normal path (that is what sets the mark). 0 (default) = off, not consulted; 1 = on; 2 =
+ * verify: decide, then run the normal path anyway and compare. Read with getenv at the first draw (after main()). */
+#define ENG_FS_N 4096u
+typedef struct {
+    const eng_im_entry* im;      /* the idx memo entry the record came from (NULL: empty) */
+    u32 regs[5];                 /* 0x1680 0x1740 0x1738 0x173C 0x1FC0 */
+    u64 vph; u32 vstart, vinstrs;   /* the vertex program memo's bytes hash, start, length */
+    u32 lo, base, span, count;   /* the entry's range */
+    const u8* ptr;               /* attribute 0's span start (stable_base: a term of the cache key) */
+    eng_vc_entry* ve; u64 vkey; u32 vgen;   /* the cache entry it ended in, its key, s_vc_gen then */
+} eng_fs_memo;
+static eng_fs_memo s_fs[ENG_FS_N];
+typedef struct {
+    int elig; eng_fs_memo* m;
+    u32 regs[5]; u64 vph; u32 vstart, vinstrs; const u8* ptr; u32 first, astride;
+    const eng_vp_memo* vp; eng_vc_entry* ve; u32 vbuf, n_verts, n_draw, ifirst, icount;
+    int slot; u32 rank;   /* fsn (draw fast N, mode 2): the slot the skip's replay call would take (-1 none, -2 not asked, -3 texdelta near-match only), its LRU rank */
+} eng_fs_dec;
+enum { FS_F_VCE, FS_F_VBUF, FS_F_NVERTS, FS_F_STRIDE, FS_F_LAYOUT, FS_F_BASE, FS_F_IM, FS_F_NDRAW, FS_F_DROP, FS_F_SLOT, FS_F_N };
+static const char* const kFsField[FS_F_N] = { "vce", "vbuf", "nverts", "stride", "layout", "base", "im", "ndraw", "dropped", "slot" };
+/* fsn: why an eligible draw was not skipped (eng_fs_decide returned 1) */
+enum { FS_R_MEMO, FS_R_VCKEY, FS_R_UNCHK, FS_R_VCHIT, FS_R_NDRAW, FS_R_TPL, FS_R_N };
+static unsigned s_fs_why[FS_R_N], s_fs_rank[ENG_DTM_MAX], s_fsn_vslot;
+static int s_fsv_pend2; static u32 s_fsv_bad, s_fsv_nd;   /* fsn mode 2: field verdict waiting for the N-slot outcome */
+static int s_fs_mode = -1;
+static unsigned s_fs_taken, s_fs_refused, s_fs_rec, s_fs_recbad;           /* mode 1 (+ records in both) */
+static unsigned s_fs_vt, s_fs_vok, s_fs_vbad, s_fs_vrep, s_fs_vf[FS_F_N];   /* mode 2 */
+static unsigned s_fs_logged;
+static eng_fs_dec s_fsv; static int s_fsv_pend, s_fsv_chk;   /* mode 2: this draw's decision, checked on the normal path */
+static unsigned s_dz_rep, s_dz_full;   /* depth-only draws replayed / taking the full path (every mode) */
+static int eng_fs_mode(void)
+{
+    if (__builtin_expect(s_fs_mode < 0, 0)) {
+        const char* e = getenv("PS3RECOMP_ENG_DT_FETCHSKIP");
+        int m = e ? atoi(e) : 0;
+        if (m < 0 || m > 2) m = 0;
+        if (m == 1 && getenv("PS3RECOMP_ENG_SAMESTATE_LOG")) {   /* that diagnostic reads the skipped layout */
+            fprintf(stderr, "[dt fetchskip] off: PS3RECOMP_ENG_SAMESTATE_LOG is set\n"); m = 0; }
+        if (m) fprintf(stderr, "[dt fetchskip] mode %d (PS3RECOMP_ENG_DT_FETCHSKIP)%s\n", m,
+                       m == 2 ? ": decide, then run the normal path and compare" : "");
+        s_fs_mode = m;
+    }
+    return s_fs_mode;
+}
+/* depth test and write on, no colour written (no colour target, or every colour mask clear) */
+static int eng_depth_only(void)
+{
+    if (!(rsx_dsp_reg(&g.rsx, M_DEPTH_WRITE) & 1u) || !(rsx_dsp_reg(&g.rsx, M_DEPTH_TEST_ENABLE) & 1u)) return 0;
+    return (rsx_dsp_reg(&g.rsx, 0x0220u) & 0x1Fu) == 0u ||
+           (rsx_dsp_reg(&g.rsx, M_COLOR_MASK) | (rsx_dsp_reg(&g.rsx, 0x0370u) & 0xFFF0u)) == 0u;
+}
+static inline void eng_dz_count(int replayed) { if (eng_depth_only()) { if (replayed) s_dz_rep++; else s_dz_full++; } }
+/* The terms of an attribute-0-only draw's vertex-cache key, read as rsx_vertex_fetch_plan_init / prepare_ex (the
+ * consecutive idx memo case) read them. 0: not such a draw. */
+static int eng_fs_inputs(const eng_im_entry* e, eng_fs_dec* d)
+{
+    d->regs[0] = rsx_dsp_reg(&g.rsx, 0x1680u); d->regs[1] = rsx_dsp_reg(&g.rsx, 0x1740u);
+    d->regs[2] = rsx_dsp_reg(&g.rsx, 0x1738u); d->regs[3] = rsx_dsp_reg(&g.rsx, 0x173Cu);
+    d->regs[4] = rsx_dsp_reg(&g.rsx, 0x1FC0u);
+    rsx_dsp_vertex_attr a; rsx_dsp_get_vertex_attr(&g.rsx, 0, &a);
+    const u32 elem = rsx_vertex_attrib_size(a.type, a.size);
+    if (!a.type || !a.size || !elem || a.frequency > 1u) return 0;
+    const u32 stride = a.stride ? a.stride : elem;
+    const u32 e0 = rsx_vertex_element_index(e->lo, e->base, 0, 0);
+    if ((u64)e0 + e->span - 1u > 0x000FFFFFu) return 0;   /* wraps: dc_fetch fills the refs, prepare_ex walks them */
+    const u64 prefix = (u64)rsx_dsp_vertex_data_base_offset(&g.rsx) + (u64)a.offset;
+    const u64 start = prefix + (u64)e0 * stride, end = prefix + (u64)(e0 + e->span - 1u) * stride + elem;
+    if (start > 0xFFFFFFFFull || end > 0x100000000ull || end <= start || end - start > 0xFFFFFFFFull) return 0;
+    d->ptr = eng_guest_ptr(NULL, a.location, (u32)start, (u32)(end - start));
+    d->first = e0; d->astride = stride;
+    return d->ptr != NULL;
+}
+/* fsn (draw fast N): a slot of this frame that eng_dtm_replay's key loop could take for an eligible draw: same
+ * topology and primitive, and the layout the draw's full path would build (eng_vertex_layout = plan_init(input_mask)
+ * with input_mask 1: mask 1, stride 16). The replay compares these again with every other key term. */
+static int eng_fs_dtm_cand(rsx_topology topology, u32 prim, u32 lmask)
+{
+    for (int i = 0; i < s_dtm_n; i++) {
+        const eng_dtm_slot* s = &s_dtm[i];
+        if (s->t.valid && s->t.frame == g.frames && s->t.topology == topology && s->t.prim == prim &&
+            s->t.stride == 16u && s->lmask == lmask) return 1;
+    }
+    return 0;
+}
+/* fsn: hand the skip's (vbuf, span, im entry, layout, n_draw) to the unchanged eng_dtm_replay. probe = 1 (mode 2):
+ * only learn the slot it would take (d->slot, d->rank). Returns 1 = replayed (d->slot, d->rank: the slot used).
+ * Refused or probed: no backend call was made and dc.vbuf / dc.n_verts are as before. */
+static int eng_fs_dtm_call(rsx_topology topology, u32 prim, eng_fs_dec* d, int probe)
+{
+    rsx_vertex_layout_plan lay;
+    rsx_vertex_layout_plan_init(&lay, d->vp->input_mask);   /* = eng_vertex_layout's layout for this vp */
+    u32 used[ENG_DTM_MAX];
+    for (int i = 0; i < s_dtm_n; i++) used[i] = s_dtm[i].used;
+    const u32 ov = dc.vbuf, on = dc.n_verts;
+    dc.vbuf = d->vbuf; dc.n_verts = d->n_verts;
+    s_dtm_probe = probe; s_dtm_probe_hit = -1;
+    const int r = eng_dtm_replay(topology, prim, &lay, 1, d->n_draw);
+    s_dtm_probe = 0;
+    if (!r) { dc.vbuf = ov; dc.n_verts = on; }
+    int hit = -1;
+    if (probe) hit = s_dtm_probe_hit;
+    else if (r) for (int i = 0; i < s_dtm_n; i++) if (s_dtm[i].used == s_dtm_clock) { hit = i; break; }
+    u32 rank = 0;   /* as eng_dtm_replay counts it: slots of this frame used more recently than the hit */
+    for (int i = 0; hit >= 0 && i < s_dtm_n; i++)
+        if (i != hit && s_dtm[i].t.valid && s_dtm[i].t.frame == g.frames && used[i] > used[hit]) rank++;
+    d->slot = hit; d->rank = rank;
+    return r;
+}
+/* 0 not eligible; 1 eligible, no skip (the normal path records); 2 skip: the normal vertex setup would end in this
+ * very vertex-cache hit and the single template's gate terms hold. dc.im_hit is this draw's fresh lookup. */
+#define FS_NO(r) do { s_fs_why[r]++; return 1; } while (0)
+static int eng_fs_decide(rsx_topology topology, u32 prim, eng_fs_dec* d)
+{
+    d->elig = 0; d->m = NULL; d->ve = NULL;
+    eng_im_entry* e = dc.im_hit;
+    if (!e || !e->span || !e->n_draw || !eng_depth_only()) return 0;
+    const eng_vp_memo* vp = NULL; const eng_fp_memo* fp = NULL;
+    if (!eng_guest_programs(&vp, &fp) || !vp || !fp) return 0;
+    if (vp->input_mask != 1u || fp->tex_mask || fp->sampled_units) return 0;
+    if (!eng_vc_on() || !eng_fs_inputs(e, d)) return 0;
+    d->vp = vp; d->vph = vp->hash; d->vstart = vp->start; d->vinstrs = vp->instrs;
+    d->ifirst = dc.idx[0].first; d->icount = e->count;
+    d->elig = 1;
+    eng_fs_memo* m = &s_fs[(u32)(e - s_im) & (ENG_FS_N - 1u)];
+    d->m = m;
+    if (m->im != e || m->vgen != s_vc_gen || memcmp(m->regs, d->regs, sizeof d->regs) || m->vph != d->vph ||
+        m->vstart != d->vstart || m->vinstrs != d->vinstrs || m->lo != e->lo || m->base != e->base ||
+        m->span != e->span || m->count != e->count || m->ptr != d->ptr) FS_NO(FS_R_MEMO);
+    eng_vc_entry* ve = m->ve;
+    if (ve->key != m->vkey || ve->skip_until > g.frames) FS_NO(FS_R_VCKEY);   /* the probe would not return this entry */
+    if (!eng_vc_entry_checked_this_frame(ve)) FS_NO(FS_R_UNCHK);              /* not validated yet this frame: normal path */
+    if (!ve->vbuf || ve->content != ve->frame_hash || ve->n != e->span || ve->stride != 16u) FS_NO(FS_R_VCHIT);   /* dc_fetch's hit test */
+    int indexed = 0;
+    if (!eng_topology_rebuild(prim, 1, &indexed) || !indexed) FS_NO(FS_R_NDRAW);
+    const u32 n_draw = rsx_draw_engine_topology_index_count(prim, e->count, dc.cuts, 0);
+    if (!n_draw || n_draw != e->n_draw) FS_NO(FS_R_NDRAW);
+    if (s_dtm_n > 1 ? !eng_fs_dtm_cand(topology, prim, vp->input_mask)   /* fsn: a slot with this topology / layout */
+                    : (topology != s_dt.topology || s_dt.stride != 16u || prim != s_dt.prim)) FS_NO(FS_R_TPL);   /* the replay gate's terms */
+    d->ve = ve; d->vbuf = ve->vbuf; d->n_verts = e->span; d->n_draw = n_draw; d->slot = -2; d->rank = 0;
+    return 2;
+}
+#undef FS_NO
+/* After the normal dc_fetch of an eligible draw: what the next ones may skip with (a vertex-cache hit only). */
+static void eng_fs_record(const eng_fs_dec* d)
+{
+    eng_im_entry* e = dc.im_hit;
+    if (!d->elig || !d->m || !e || !dc.vce || !dc.vbuf_hit || dc.layout.count != 1u || dc.layout.stride != 16u) return;
+    const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[0];
+    if (f->stable_base != d->ptr || f->stable_first != d->first) { s_fs_recbad++; return; }   /* never skip on a misreading */
+    eng_fs_memo* m = d->m;
+    const eng_vc_entry* v = (const eng_vc_entry*)dc.vce;
+    m->im = e; memcpy(m->regs, d->regs, sizeof m->regs);
+    m->vph = d->vph; m->vstart = d->vstart; m->vinstrs = d->vinstrs;
+    m->lo = e->lo; m->base = e->base; m->span = e->span; m->count = e->count; m->ptr = d->ptr;
+    m->ve = (eng_vc_entry*)dc.vce; m->vkey = v->key; m->vgen = s_vc_gen;
+    s_fs_rec++;
+}
+static void eng_fs_vreport(u32 bad, u32 n_draw)
+{
+    const eng_fs_dec* d = &s_fsv;
+    s_fs_vt++;
+    if (!bad) { s_fs_vok++; return; }
+    s_fs_vbad++;
+    for (u32 i = 0; i < FS_F_N; i++) if ((bad >> i) & 1u) s_fs_vf[i]++;
+    if (s_fs_logged < 8) {
+        s_fs_logged++;
+        char w[96]; size_t k = 0; w[0] = 0;
+        for (u32 i = 0; i < FS_F_N; i++) if ((bad >> i) & 1u) k += (size_t)snprintf(w + k, sizeof w - k, "%s%s", k ? "," : "", kFsField[i]);
+        fprintf(stderr, "[dt fetchskip] MISMATCH draw %u frame %u: %s (skip: vce %p vbuf %u nverts %u ndraw %u base %u;"
+                        " normal: vce %p vbuf %u nverts %u ndraw %u base %u)\n", s_draw_serial, g.frames, w,
+                (const void*)d->ve, d->vbuf, d->n_verts, d->n_draw, d->first, dc.vce, dc.vbuf, dc.n_verts, n_draw,
+                dc.fetch_plan.attr[0].stable_first);
+    }
+}
+static void eng_fs_verify(u32 n_draw, int indexed, const rsx_vertex_layout_plan* layout)
+{
+    s_fsv_pend = 0; s_fsv_chk = 1;
+    const eng_fs_dec* d = &s_fsv;
+    const eng_im_entry* e = dc.im_hit;
+    const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[0];
+    u32 bad = 0;
+    if ((const void*)dc.vce != (const void*)d->ve || !dc.vbuf_hit) bad |= 1u << FS_F_VCE;
+    if (dc.vbuf != d->vbuf) bad |= 1u << FS_F_VBUF;
+    if (dc.n_verts != d->n_verts || dc.n_refs != d->n_verts) bad |= 1u << FS_F_NVERTS;
+    if (layout->stride != 16u || dc.layout.stride != 16u || f->stride != d->astride) bad |= 1u << FS_F_STRIDE;
+    if (layout->count != 1u || layout->mask != 1u || layout->attrs[0] != 0u) bad |= 1u << FS_F_LAYOUT;
+    if (f->stable_base != d->ptr || f->stable_first != d->first) bad |= 1u << FS_F_BASE;
+    if (!e || e != d->m->im || dc.n_source_refs != d->icount || dc.idx[0].first != d->ifirst || e->f[2] != d->ifirst ||
+        e->f[3] != d->icount) bad |= 1u << FS_F_IM;
+    if (!indexed || n_draw != d->n_draw) bad |= 1u << FS_F_NDRAW;
+    if (d->slot != -2) {   /* fsn: the whole layout the skip handed over; the slot is judged at the N-slot replay call */
+        rsx_vertex_layout_plan lay; rsx_vertex_layout_plan_init(&lay, d->vp->input_mask);
+        if (memcmp(layout, &lay, sizeof lay)) bad |= 1u << FS_F_LAYOUT;
+        s_fsv_bad = bad; s_fsv_nd = n_draw; s_fsv_pend2 = 1;
+        return;
+    }
+    eng_fs_vreport(bad, n_draw);
+}
+static void eng_fs_vdrop(void) { s_fsv_pend = 0; eng_fs_vreport(s_fsv.slot == -1 || s_fsv.slot == -3 ? 0u : 1u << FS_F_DROP, 0); }   /* the normal path dropped it (fsn: a refused N-slot call drops in mode 1 too) */
+/* fsn mode 2: the normal path's N-slot outcome (replayed: the slot = the one used last; dropped: never reached the call)
+ * against the slot the skip's own call picked. A mode 1 skip whose call is refused takes this same full path. */
+static void eng_fs_vslot(int replayed, int dropped)
+{
+    s_fsv_pend2 = 0;
+    int got = -1;
+    if (replayed) for (int i = 0; i < s_dtm_n; i++) if (s_dtm[i].used == s_dtm_clock) { got = i; break; }
+    u32 bad = s_fsv_bad;
+    if (dropped) { if (s_fsv.slot >= 0) bad |= 1u << FS_F_DROP; }   /* mode 1 would have replayed it */
+    else if (s_fsv.slot != -3 && got != s_fsv.slot) { bad |= 1u << FS_F_SLOT; s_fsn_vslot++; }   /* tdfix: -3 texdelta may or may not replay */
+    if (replayed) { s_fs_vrep++; if (!bad) s_fs_rank[s_fsv.rank]++; }
+    if ((bad & (1u << FS_F_SLOT)) && s_fs_logged < 8)
+        fprintf(stderr, "[dt fetchskip] N=%d slot: skip's call %d (rank %u), normal path %d\n", s_dtm_n, s_fsv.slot, s_fsv.rank, got);
+    eng_fs_vreport(bad, s_fsv_nd);
+}
+static void eng_fs_frame_end(void)   /* once per present */
+{
+    static u32 n;
+    if (++n < 300u) return;
+    n = 0;
+    fprintf(stderr, "[dt depthonly] last 300 frames: per frame %.1f replayed, %.1f full path (draws into depth-only targets)\n",
+            s_dz_rep / 300.0, s_dz_full / 300.0);
+    s_dz_rep = s_dz_full = 0;
+    if (s_fs_mode == 1)
+        fprintf(stderr, "[dt fetchskip] mode 1: last 300 frames: %u skipped (%.1f per frame), %u refused by the template (normal path),"
+                        " %u records, %u records refused\n", s_fs_taken, s_fs_taken / 300.0, s_fs_refused, s_fs_rec, s_fs_recbad);
+    else if (s_fs_mode == 2) {
+        fprintf(stderr, "[dt fetchskip] taken %u ok %u MISMATCH %u (vce %u vbuf %u nverts %u stride %u layout %u base %u im %u"
+                        " ndraw %u dropped %u); replayed %u (%.1f per frame = mode 1's skips), %u records, %u records refused\n",
+                s_fs_vt, s_fs_vok, s_fs_vbad, s_fs_vf[FS_F_VCE], s_fs_vf[FS_F_VBUF], s_fs_vf[FS_F_NVERTS], s_fs_vf[FS_F_STRIDE],
+                s_fs_vf[FS_F_LAYOUT], s_fs_vf[FS_F_BASE], s_fs_vf[FS_F_IM], s_fs_vf[FS_F_NDRAW], s_fs_vf[FS_F_DROP],
+                s_fs_vrep, s_fs_vrep / 300.0, s_fs_rec, s_fs_recbad);
+        s_fs_vt = s_fs_vok = s_fs_vbad = s_fs_vrep = 0; memset(s_fs_vf, 0, sizeof s_fs_vf);
+    }
+    if (s_fs_mode > 0 && s_dtm_n > 1) {   /* fsn */
+        char rk[ENG_DTM_MAX * 8 + 8]; int o = 0;
+        for (int i = 0; i < s_dtm_n && o < (int)sizeof rk - 12; i++) o += snprintf(rk + o, sizeof rk - o, "%s%u", i ? "/" : "", s_fs_rank[i]);
+        fprintf(stderr, "[dt fetchskip] N=%d: %s by LRU rank %s; slot MISMATCH %u; not skipped: memo %u vckey %u unchecked %u"
+                        " vchit %u ndraw %u noslot(layout/topology) %u\n", s_dtm_n, s_fs_mode == 1 ? "skips" : "verified replays", rk,
+                s_fsn_vslot, s_fs_why[FS_R_MEMO], s_fs_why[FS_R_VCKEY], s_fs_why[FS_R_UNCHK], s_fs_why[FS_R_VCHIT],
+                s_fs_why[FS_R_NDRAW], s_fs_why[FS_R_TPL]);
+    }
+    memset(s_fs_rank, 0, sizeof s_fs_rank); memset(s_fs_why, 0, sizeof s_fs_why); s_fsn_vslot = 0;
+    s_fs_taken = s_fs_refused = s_fs_rec = s_fs_recbad = 0;
+}
+/* FS_END */
+
+/* CT_BEGIN ---- casterfix (work/agent_casterfix/NOTES.md) ------------------------------------------------------------
+ * PS3RECOMP_ENG_CASTER_FAST=3 = caster fast 2 with the vertex cache's own trust rule: a replayed caster skips layout,
+ * plan and vertex-cache probe only when the remembered cache entry passes eng_vc_entry_checked_this_frame (the probe's
+ * "already checked this frame" early return) and dc_fetch's hit test, and every input of that entry's key still equals
+ * the recorded one (registers 0x1680 0x1740 0x1738 0x173C 0x1FC0 compared through a 64-bit mix, attribute 0's host
+ * span pointer = the mapping, the vertex program, the idx entry's range), and the index count recomputes to n_draw.
+ * The first use of a buffer in a frame therefore always takes the normal path. Mode 2 is unchanged (A/B).
+ * PS3RECOMP_ENG_CASTER_VERIFY=1 (modes 2 and 3): decide, then run the normal path anyway and compare; read with getenv
+ * at the first caster-fast-2/3 draw (after main()). */
+static int s_ctv = -1;
+static unsigned s_ct_recbad;
+static inline int eng_ctv_on(void)
+{
+    if (__builtin_expect(s_ctv < 0, 0)) {
+        const char* e = getenv("PS3RECOMP_ENG_CASTER_VERIFY");
+        s_ctv = e && atoi(e) == 1;
+        if (s_ctv) fprintf(stderr, "[ct verify] on (PS3RECOMP_ENG_CASTER_VERIFY=1): caster fast %d decides, the normal path draws and is compared\n",
+                           __atomic_load_n(&s_ct_on, __ATOMIC_RELAXED));
+    }
+    return s_ctv;
+}
+static inline u32 eng_ct_laysig(const rsx_vertex_layout_plan* l) { return (u32)l->count | (l->mask << 8) | (l->stride << 24) | ((u32)l->attrs[0] << 20); }
+/* Every input of an attribute-0 caster's vertex-cache key; 0 = not such a draw (never recorded, never matched). */
+static u64 eng_ct_tag3(const eng_im_entry* e, eng_fs_dec* d)
+{
+    if (!eng_fs_inputs(e, d)) return 0;
+    const eng_vp_memo* vp = NULL;
+    if (!eng_guest_programs(&vp, NULL) || !vp) return 0;
+    u64 t = 0x6A09E667F3BCC908ull;
+    for (int k = 0; k < 5; k++) t = eng_vc_mix(t, d->regs[k]);
+    t = eng_vc_mix(t, (u64)(uintptr_t)d->ptr); t = eng_vc_mix(t, ((u64)d->first << 32) | d->astride);
+    t = eng_vc_mix(t, vp->hash); t = eng_vc_mix(t, ((u64)vp->start << 32) | vp->instrs); t = eng_vc_mix(t, vp->input_mask);
+    t = eng_vc_mix(t, ((u64)e->lo << 32) | e->base); t = eng_vc_mix(t, ((u64)e->span << 32) | e->count);
+    t = eng_vc_mix(t, e->key);
+    return t ? t : 1;
+}
+/* After a normal-path vertex-cache hit of a plain caster: what the next replays of this idx entry may skip with. */
+static void eng_ct_record(eng_im_entry* e, const rsx_vertex_layout_plan* layout)
+{
+    const eng_vc_entry* v = (const eng_vc_entry*)dc.vce;
+    e->fc_vce = dc.vce; e->fc_vkey = v->key; e->fc_vbuf = dc.vbuf; e->fc_nverts = dc.n_verts;
+    e->fc_tag = eng_caster_attr_tag(); e->fc_frame = g.frames;
+    e->fc_tag3 = 0;
+    if (__atomic_load_n(&s_ct_on, __ATOMIC_RELAXED) != 3 && !eng_ctv_on()) return;   /* modes 1/2: today's record */
+    eng_fs_dec d;
+    const u64 t = eng_ct_tag3(e, &d);
+    const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[0];
+    if (!t || f->stable_base != d.ptr || f->stable_first != d.first || layout->count != 1u || layout->attrs[0] != 0u) {
+        s_ct_recbad++; return; }   /* never skip on a misreading */
+    e->fc_tag3 = t; e->fc_ptr = d.ptr; e->fc_first = d.first; e->fc_vgen = s_vc_gen; e->fc_lay = eng_ct_laysig(layout);
+}
+/* Today's mode 2 gate (unchanged). */
+static inline int eng_ct2_gate(const eng_im_entry* e)
+{
+    return e && e->fc_vce && e->n_draw && g.frames - e->fc_frame < 4u && e->fc_tag == eng_caster_attr_tag() &&
+           ((eng_vc_entry*)e->fc_vce)->key == e->fc_vkey && ((eng_vc_entry*)e->fc_vce)->vbuf == e->fc_vbuf;
+}
+/* Mode 3: the normal path would return this very cache entry without hashing and hand over this buffer. */
+static int eng_ct3_gate(const eng_im_entry* e, u32 prim)
+{
+    if (!e || !e->fc_vce || !e->n_draw || !e->fc_tag3 || e->fc_vgen != s_vc_gen) return 0;
+    const eng_vc_entry* v = (const eng_vc_entry*)e->fc_vce;
+    if (v->key != e->fc_vkey || v->skip_until > g.frames) return 0;   /* the probe would not return this entry */
+    if (!eng_vc_entry_checked_this_frame(v)) return 0;                /* not validated yet this frame: normal path */
+    if (!v->vbuf || v->vbuf != e->fc_vbuf || v->content != v->frame_hash || v->n != e->span || v->n != e->fc_nverts ||
+        v->stride != s_ct.stride) return 0;                            /* dc_fetch's hit test */
+    eng_fs_dec d;
+    if (eng_ct_tag3(e, &d) != e->fc_tag3 || d.ptr != e->fc_ptr || d.first != e->fc_first) return 0;   /* key inputs */
+    int indexed = 0;
+    if (!eng_topology_rebuild(prim, 1, &indexed) || !indexed) return 0;
+    if (rsx_draw_engine_topology_index_count(prim, e->count, dc.cuts, 0) != e->n_draw) return 0;
+    return 1;
+}
+/* verify */
+enum { CT_F_VCE, CT_F_VBUF, CT_F_NVERTS, CT_F_STRIDE, CT_F_LAYOUT, CT_F_BASE, CT_F_IM, CT_F_NDRAW, CT_F_DROP, CT_F_N };
+static const char* const kCtField[CT_F_N] = { "vce", "vbuf", "nverts", "stride", "layout", "base", "im", "ndraw", "dropped" };
+static struct {
+    int pend;   /* 1 decided, 2 compared (waiting for the caster-fast replay site) */
+    const eng_im_entry* e; const void* vce; u32 vbuf, nverts, n_draw, first, count, lay, has3; const u8* ptr; u32 pfirst;
+    u64 content; u32 bad; int stale, stale_normal, hashed;
+} s_ctv_d;
+static int s_ctv_norec;   /* this draw was a taken decision: no record (the fast path would not have recorded) */
+static unsigned s_ctv_t, s_ctv_ok, s_ctv_bad, s_ctv_f[CT_F_N], s_ctv_stale, s_ctv_stale_n, s_ctv_unh, s_ctv_logged;
+static unsigned s_ctv_gate, s_ctv_g2, s_ctv_g3;   /* gate draws (idx hit with a record), mode 2 / mode 3 gate passes */
+static void eng_ctv_begin(const eng_im_entry* e)
+{
+    const eng_vc_entry* v = (const eng_vc_entry*)e->fc_vce;
+    s_ctv_d.pend = 1; s_ctv_d.e = e; s_ctv_d.vce = e->fc_vce; s_ctv_d.vbuf = e->fc_vbuf; s_ctv_d.nverts = e->fc_nverts;
+    s_ctv_d.n_draw = e->n_draw; s_ctv_d.first = dc.idx[0].first; s_ctv_d.count = e->count;
+    s_ctv_d.has3 = e->fc_tag3 != 0; s_ctv_d.lay = e->fc_lay; s_ctv_d.ptr = e->fc_ptr; s_ctv_d.pfirst = e->fc_first;
+    s_ctv_d.content = v->content;   /* = the hash of the bytes in v->vbuf (after_fetch drops the buffer on any change) */
+    s_ctv_d.bad = 0; s_ctv_d.stale = s_ctv_d.stale_normal = 0; s_ctv_d.hashed = 0;
+}
+/* The probe's span union, hashed in full (eng_vc_probe's full-hash branch). 0: not a plain span. */
+static int eng_ctv_full_hash(const rsx_vertex_layout_plan* layout, u64* out)
+{
+    const rsx_vertex_fetch_plan* pl = &dc.fetch_plan;
+    const u8* lo[RSX_DSP_NUM_VERTEX_ATTR]; const u8* hi[RSX_DSP_NUM_VERTEX_ATTR];
+    u32 nr = 0;
+    for (u32 slot = 0; slot < layout->count; slot++) {
+        const rsx_vertex_fetch_attr* f = &pl->attr[layout->attrs[slot]];
+        if (!(f->desc.type && f->desc.size && f->elem_size)) continue;
+        if (!f->stable_base) return 0;
+        lo[nr] = f->stable_base;
+        hi[nr] = f->stable_base + (u64)(f->stable_last - f->stable_first) * f->stride + f->elem_size;
+        nr++;
+    }
+    for (u32 i = 1; i < nr; i++)
+        for (u32 j = i; j > 0 && lo[j] < lo[j - 1]; j--) {
+            const u8* t = lo[j]; lo[j] = lo[j - 1]; lo[j - 1] = t;
+            t = hi[j]; hi[j] = hi[j - 1]; hi[j - 1] = t;
+        }
+    u64 c = 0x51ED270B27A3F5E1ull;
+    for (u32 i = 0; i < nr; ) {
+        const u8* a0 = lo[i]; const u8* a1 = hi[i];
+        for (i++; i < nr && lo[i] <= a1 + 64; i++) if (hi[i] > a1) a1 = hi[i];
+        c = eng_hash_span(a0, (u64)(a1 - a0), c);
+    }
+    *out = c;
+    return 1;
+}
+/* After the normal path's n_draw: compare what the fast decision would have drawn. */
+static void eng_ctv_compare(u32 n_draw, int indexed, const rsx_vertex_layout_plan* layout)
+{
+    s_ctv_d.pend = 2;
+    const rsx_vertex_fetch_attr* f = &dc.fetch_plan.attr[0];
+    u32 bad = 0;
+    if (dc.vce != s_ctv_d.vce || !dc.vbuf_hit) bad |= 1u << CT_F_VCE;
+    if (dc.vbuf != s_ctv_d.vbuf) bad |= 1u << CT_F_VBUF;
+    if (dc.n_verts != s_ctv_d.nverts) bad |= 1u << CT_F_NVERTS;
+    if (layout->stride != s_ct.stride || dc.layout.stride != layout->stride) bad |= 1u << CT_F_STRIDE;
+    if (s_ctv_d.has3 && eng_ct_laysig(layout) != s_ctv_d.lay) bad |= 1u << CT_F_LAYOUT;
+    if (s_ctv_d.has3 && (f->stable_base != s_ctv_d.ptr || f->stable_first != s_ctv_d.pfirst)) bad |= 1u << CT_F_BASE;
+    if (dc.im_hit != s_ctv_d.e || dc.n_source_refs != s_ctv_d.count || dc.idx[0].first != s_ctv_d.first) bad |= 1u << CT_F_IM;
+    if (!indexed || n_draw != s_ctv_d.n_draw) bad |= 1u << CT_F_NDRAW;
+    s_ctv_d.bad = bad;
+    u64 h = 0;
+    if (eng_ctv_full_hash(layout, &h)) {
+        s_ctv_d.hashed = 1;
+        if (h != s_ctv_d.content) {   /* the fast path's buffer does not hold the guest's vertices now */
+            s_ctv_d.stale = 1;
+            s_ctv_d.stale_normal = dc.vbuf_hit && dc.vbuf == s_ctv_d.vbuf;   /* ...and the normal path drew it too */
+        }
+    }
+}
+static void eng_ctv_commit(u32 bad)
+{
+    s_ctv_d.pend = 0; s_ctv_norec = 1;
+    s_ctv_t++;
+    if (s_ctv_d.stale) { s_ctv_stale++; if (s_ctv_d.stale_normal) s_ctv_stale_n++; }
+    if (!s_ctv_d.hashed && !(bad >> CT_F_DROP)) s_ctv_unh++;
+    if (!bad) { s_ctv_ok++; return; }
+    s_ctv_bad++;
+    for (u32 i = 0; i < CT_F_N; i++) if ((bad >> i) & 1u) s_ctv_f[i]++;
+    if (s_ctv_logged < 8) {
+        s_ctv_logged++;
+        char w[96]; size_t k = 0; w[0] = 0;
+        for (u32 i = 0; i < CT_F_N; i++) if ((bad >> i) & 1u) k += (size_t)snprintf(w + k, sizeof w - k, "%s%s", k ? "," : "", kCtField[i]);
+        fprintf(stderr, "[ct verify] MISMATCH draw %u frame %u: %s%s (fast: vce %p vbuf %u nverts %u ndraw %u;"
+                        " normal: vce %p vbuf %u nverts %u hit %d)\n", s_draw_serial, g.frames, w, s_ctv_d.stale ? " stale-content" : "",
+                s_ctv_d.vce, s_ctv_d.vbuf, s_ctv_d.nverts, s_ctv_d.n_draw, dc.vce, dc.vbuf, dc.n_verts, dc.vbuf_hit);
+    }
+}
+static void eng_ctv_drop(void) { if (s_ctv_d.pend) eng_ctv_commit(1u << CT_F_DROP); }   /* the normal path dropped it */
+/* At the caster-fast replay site: replayed = the fast path's state gate held too. Not replayed with every field equal =
+ * the template refused for state reasons, which the fast path would have met as well: not a taken draw. */
+static void eng_ctv_resolve(int replayed)
+{
+    if (s_ctv_d.pend != 2) return;
+    if (replayed || s_ctv_d.bad) eng_ctv_commit(s_ctv_d.bad);
+    else s_ctv_d.pend = 0;
+}
+static void eng_ctv_frame_end(void)   /* once per present */
+{
+    static u32 n;
