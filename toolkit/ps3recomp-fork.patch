+}
+VMX_XV void vmx_vrefp_vec(VMX_D, VMX_B, uint32_t vscr) {
+    const __m128i y = vmx__flush(vmx__ld(b_), vscr);
+    const __m128i z = _mm_castps_si128(_mm_div_ps(_mm_set1_ps(1.0f), _mm_castsi128_ps(y)));
+    vmx__st(d_, vmx__flush(vmx__nan1(z, y), vscr));
+}
+VMX_XV void vmx_vrsqrtefp_vec(VMX_D, VMX_B, uint32_t vscr) {
+    const __m128i y = vmx__flush(vmx__ld(b_), vscr);
+    const __m128i z = _mm_castps_si128(_mm_div_ps(_mm_set1_ps(1.0f), _mm_sqrt_ps(_mm_castsi128_ps(y))));
+    vmx__st(d_, vmx__flush(vmx__nan1(z, y), vscr));
+}
+VMX_XV void vmx_vmaxfp_vec(VMX_D, VMX_A, VMX_B, uint32_t vscr) {   /* vmx_maxf per lane, then vnan2 + NJ flush */
+    const __m128i xi = vmx__ld(a_), yi = vmx__ld(b_);
+    const __m128 x = _mm_castsi128_ps(xi), y = _mm_castsi128_ps(yi);
+    __m128 z = _mm_blendv_ps(y, x, _mm_cmpgt_ps(x, y));                              /* x > y ? x : y */
+    const __m128 zz = _mm_and_ps(_mm_cmpeq_ps(x, _mm_setzero_ps()), _mm_cmpeq_ps(y, _mm_setzero_ps()));
+    z = _mm_blendv_ps(z, _mm_blendv_ps(x, y, x), zz);                                /* both 0: signbit(x) ? y : x */
+    vmx__st(d_, vmx__flush(vmx__nan2(_mm_castps_si128(z), xi, yi), vscr));
+}
+VMX_XV void vmx_vminfp_vec(VMX_D, VMX_A, VMX_B, uint32_t vscr) {
+    const __m128i xi = vmx__ld(a_), yi = vmx__ld(b_);
+    const __m128 x = _mm_castsi128_ps(xi), y = _mm_castsi128_ps(yi);
+    __m128 z = _mm_blendv_ps(y, x, _mm_cmplt_ps(x, y));                              /* x < y ? x : y */
+    const __m128 zz = _mm_and_ps(_mm_cmpeq_ps(x, _mm_setzero_ps()), _mm_cmpeq_ps(y, _mm_setzero_ps()));
+    z = _mm_blendv_ps(z, _mm_blendv_ps(y, x, x), zz);                                /* both 0: signbit(x) ? x : y */
+    vmx__st(d_, vmx__flush(vmx__nan2(_mm_castps_si128(z), xi, yi), vscr));
+}
+VMX_XV uint32_t vmx__cr6(__m128 m, void* d_) {   /* store the all-ones/zero lanes; CR6 = [all, 0, none, 0] */
+    _mm_storeu_si128((__m128i*)d_, _mm_castps_si128(m));
+    const int k = _mm_movemask_ps(m);
+    return (uint32_t)((k == 0xF) << 3 | (k == 0) << 1);
+}
+VMX_XV uint32_t vmx_vcmpgtfp_vec(VMX_D, VMX_A, VMX_B) {
+    return vmx__cr6(_mm_cmpgt_ps(_mm_castsi128_ps(vmx__ld(a_)), _mm_castsi128_ps(vmx__ld(b_))), d_); }
+VMX_XV uint32_t vmx_vcmpgefp_vec(VMX_D, VMX_A, VMX_B) {
+    return vmx__cr6(_mm_cmpge_ps(_mm_castsi128_ps(vmx__ld(a_)), _mm_castsi128_ps(vmx__ld(b_))), d_); }
+VMX_XV uint32_t vmx_vcmpeqfp_vec(VMX_D, VMX_A, VMX_B) {
+    return vmx__cr6(_mm_cmpeq_ps(_mm_castsi128_ps(vmx__ld(a_)), _mm_castsi128_ps(vmx__ld(b_))), d_); }
+VMX_XV uint32_t vmx_vcmpequw_vec(VMX_D, VMX_A, VMX_B) {   /* lane equality is byte-order independent */
+    return vmx__cr6(_mm_castsi128_ps(_mm_cmpeq_epi32(_mm_loadu_si128((const __m128i*)a_), _mm_loadu_si128((const __m128i*)b_))), d_); }
+#define vmx_vrefp     vmx_vrefp_vec
+#define vmx_vrsqrtefp vmx_vrsqrtefp_vec
+#define vmx_vmaxfp    vmx_vmaxfp_vec
+#define vmx_vminfp    vmx_vminfp_vec
+#define vmx_vcmpgtfp  vmx_vcmpgtfp_vec
+#define vmx_vcmpgefp  vmx_vcmpgefp_vec
+#define vmx_vcmpeqfp  vmx_vcmpeqfp_vec
+#define vmx_vcmpequw  vmx_vcmpequw_vec
+#endif   /* ppu vmx vec */
+
 #ifdef __cplusplus
 }
 #endif
