+/* ds light: the game's colour on the light bar (PS3_LIGHTBAR=r,g,b, set per game by the app) while the DualSense
+ * features are on; the system's own colour otherwise. Applied when it changes. */
+static void pad_ps5_light(void)
+{
+    static int last = -2;
+    const int on = pad_ds_features();
+    if (s_ps5_pad < 0 || on == last) return;
+    last = on;
+    if (on) {
+        int r = 40, g = 110, b = 255;
+        const char* e = getenv("PS3_LIGHTBAR"); if (e) sscanf(e, "%d,%d,%d", &r, &g, &b);
