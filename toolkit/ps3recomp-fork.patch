+/* occ query: the engine's bracket around the draws of one pixel-count section (rsx_draw_engine.h). */
+static void vk_eng_occq_end(void* user)
+{
+    (void)user;
+    if (!s_oq.want) return;
+    vk_oq_end_phys();   /* open only while the pass it began in is */
+    const u32 li = (u32)s_oq.cur_lq;
+    s_oq.want = 0; s_oq.cur_lq = -1;
+    s_oq.lq[li].ended = 1;
+    if (!s_oq.lq[li].pending) vk_oq_finish(li);   /* no draw reached a pass: answered now */
+    vk_oq_poll();
+}
+static void vk_eng_occq_begin(void* user, u32 id)
+{
+    if (s_oq.want) vk_eng_occq_end(user);
