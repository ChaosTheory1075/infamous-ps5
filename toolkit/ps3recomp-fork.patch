+        if (z->snapshot_rgba == h) { z->snapshot_rgba = 0; z->snapshot_rgba_valid = 0; held = 1; }
+        if (z->crop_rgba == h)     { z->crop_rgba = 0; z->crop_valid = 0; z->crop_w = z->crop_h = 0; held = 1; }
+        if (z->crop_z == h)        { z->crop_z = 0; z->crop_z_valid = 0; z->crop_z_w = z->crop_z_h = 0; held = 1; }
+    }
