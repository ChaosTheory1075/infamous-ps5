+/* vk framegen: one generated frame between each two finished ones (MihawkGen's neural method), presented
+ * before the real frame. PS3_FRAMEGEN=1 (launcher.ini frame_generation) turns it on; 0 = off. The finished
+ * frame is copied into one of two input images; the network reads the previous and this one. */
+static struct {
+    int on, failed, have_prev; u32 cur, n;
+    vk_image in[2], out;
+    VkSemaphore acq[4]; u32 acq_i;
+} s_fg = { .on = -1 };
+static int vk_fg_ready(void)
+{
+    if (s_fg.on < 0) { const char* e = getenv("PS3_FRAMEGEN"); s_fg.on = e && *e == '1'; }
+    if (!s_fg.on || s_fg.failed) return 0;
+    if (s_fg.out.img) return 1;
+    char err[256] = "";
+    if (vkfg_init(s_vk.instance, s_vk.phys, s_vk.device, pvkGetInstanceProcAddr, s_vk.width, s_vk.height, 2u, err, sizeof err)) {
+        VK_LOG("frame generation: off (%s)\n", err); s_fg.failed = 1; return 0; }
+    for (int i = 0; i < 2; i++)
+        if (vk_create_image(&s_fg.in[i], VK_FORMAT_R8G8B8A8_UNORM, s_vk.width, s_vk.height,
+                            VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, VK_IMAGE_ASPECT_COLOR_BIT)) { s_fg.failed = 1; return 0; }
+    if (vk_create_image(&s_fg.out, VK_FORMAT_R8G8B8A8_UNORM, s_vk.width, s_vk.height,
+                        VK_IMAGE_USAGE_STORAGE_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_SAMPLED_BIT /* vk fsr */, VK_IMAGE_ASPECT_COLOR_BIT)) { s_fg.failed = 1; return 0; }
+    VkSemaphoreCreateInfo semi = { .sType = VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO };
+    for (int i = 0; i < 4; i++)
+        if (pvkCreateSemaphore(s_vk.device, &semi, NULL, &s_fg.acq[i]) != VK_SUCCESS) { s_fg.failed = 1; return 0; }
+    VK_LOG("frame generation: on (MihawkGen neural, %ux%u)\n", s_vk.width, s_vk.height);
+    return 1;
+}
+static void vk_img_barrier(VkImage img, VkImageLayout from, VkImageLayout to, VkAccessFlags sa, VkAccessFlags da,
+                           VkPipelineStageFlags ss, VkPipelineStageFlags ds)
+{
+    VkImageMemoryBarrier b = { .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .srcAccessMask = sa, .dstAccessMask = da,
+        .oldLayout = from, .newLayout = to, .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .image = img, .subresourceRange = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1 } };
+    pvkCmdPipelineBarrier(s_vk.cmd, ss, ds, 0, 0, NULL, 0, NULL, 1, &b);
+}
+#include "vk_fsr.inc"   /* vk fsr: FSR 1 upscale at present */
+#include "vk_quickmenu.inc"   /* vk quickmenu: L3+R3 in-game menu (after vk_overlay.inc and vk_fsr.inc) */
+#include "vk_fgguard.inc"   /* vk fg guard: frame generation ghost guards (fg guard: interval + difference) */
+#include "vk_fgflow.inc"   /* vk fg flow: motion search + mvwarp */
+/* Records: this frame's colour -> in[cur]; when there is a previous frame, the generated frame -> out (left in
+ * TRANSFER_SRC_OPTIMAL). Returns 1 when out holds a generated frame.
+ * fg guard: hold = the interval guard holds this pair: the frame is kept for the next pair, nothing is generated. */
+static int vk_fg_record(int hold)
+{
+    VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+        .srcAccessMask = VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT | VK_ACCESS_SHADER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+    vk_img_barrier(s_fg.in[s_fg.cur].img, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                   VK_ACCESS_SHADER_READ_BIT, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    VkImageCopy cp = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 }, .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                       .extent = { s_vk.width, s_vk.height, 1 } };
+    pvkCmdCopyImage(s_vk.cmd, s_vk.color.img, VK_IMAGE_LAYOUT_GENERAL, s_fg.in[s_fg.cur].img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &cp);
+    vk_img_barrier(s_fg.in[s_fg.cur].img, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+                   VK_ACCESS_TRANSFER_WRITE_BIT, VK_ACCESS_SHADER_READ_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+    const int gen = s_fg.have_prev && !hold;   /* fg guard */
+    if (gen) {
+        vk_img_barrier(s_fg.out.img, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
+                       VK_ACCESS_TRANSFER_READ_BIT, VK_ACCESS_SHADER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+        if (vk_fgf_record(s_fg.n & 1u, s_fg.cur, s_fg.in[0].view, s_fg.in[1].view, s_fg.out.view, 0.5f)) {   /* vk fg flow */
+        vkfg_record(s_vk.cmd, s_fg.n & 1u, s_fg.in[s_fg.cur ^ 1u].view, s_fg.in[s_fg.cur].view, s_fg.out.view, 0.5f);
+        }
+        vk_fgg_record(s_fg.cur, s_fg.in[0].view, s_fg.in[1].view, s_fg.out.view);   /* fg guard: after either method (was: neural only) */
+        vk_img_barrier(s_fg.out.img, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                       VK_ACCESS_SHADER_WRITE_BIT, VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    }
+    s_fg.have_prev = 1; s_fg.cur ^= 1u; s_fg.n++;
+    return gen;
+}
+/* vk framegen pacing: the real frame is presented half a frame interval after the generated one, by this thread,
+ * so the two share the interval evenly instead of "one refresh, then the rest" (the user: "choppy"). */
+static struct {
+    pthread_mutex_t mu; pthread_cond_t cv; int started, pending, lost;
+    u32 idx; uint64_t due; uint64_t last_call, ema;
+} s_pace = { .mu = PTHREAD_MUTEX_INITIALIZER, .cv = PTHREAD_COND_INITIALIZER };
+static void vk_pace_present_now(u32 idx)   /* s_pace.mu held by the caller or not needed */
+{
+    VkPresentInfoKHR pi = { .sType = VK_STRUCTURE_TYPE_PRESENT_INFO_KHR, .waitSemaphoreCount = 1, .pWaitSemaphores = &s_vk.sc_done[idx],
+                            .swapchainCount = 1, .pSwapchains = &s_vk.swapchain, .pImageIndices = &idx };
+    vk_queue_lock();
+    const VkResult r = pvkQueuePresentKHR(s_vk.queue, &pi);
+    vk_queue_unlock();
+    if (r == VK_ERROR_OUT_OF_DATE_KHR || r == VK_SUBOPTIMAL_KHR) s_pace.lost = 1;
+}
+static void* vk_pace_main(void* arg)
+{
+    (void)arg;
+    { extern void ps3_host_thread_label(const char*) __attribute__((weak)); if (ps3_host_thread_label) ps3_host_thread_label("vk present pacer"); }
+    pthread_mutex_lock(&s_pace.mu);
+    for (;;) {
+        while (!s_pace.pending) pthread_cond_wait(&s_pace.cv, &s_pace.mu);
+        const uint64_t now = ps3_ft_now();
+        if (now < s_pace.due) {
+            struct timespec ts; clock_gettime(CLOCK_REALTIME, &ts);
+            const uint64_t ns = (uint64_t)ts.tv_nsec + (s_pace.due - now);
+            ts.tv_sec += (time_t)(ns / 1000000000ull); ts.tv_nsec = (long)(ns % 1000000000ull);
+            pthread_cond_timedwait(&s_pace.cv, &s_pace.mu, &ts);
+            continue;   /* re-check: due, or flushed by the producer */
+        }
+        const u32 idx = s_pace.idx; s_pace.pending = 0;
+        vk_pace_present_now(idx);
+        pthread_cond_broadcast(&s_pace.cv);
+    }
+    return NULL;
+}
+/* Present a waiting real frame now (before anything else is presented). */
+static void vk_pace_flush(void)
+{
+    if (!s_pace.started) return;
+    pthread_mutex_lock(&s_pace.mu);
+    if (s_pace.pending) { s_pace.pending = 0; vk_pace_present_now(s_pace.idx); }
+    pthread_mutex_unlock(&s_pace.mu);
+}
+/* Hand the real frame to the presenter: due half the running frame interval from now. 0 if no thread. */
+static int vk_pace_queue(u32 idx)
+{
+    static int on = -1;
+    if (on < 0) { const char* e = getenv("PS3_FRAMEGEN_PACE"); on = !(e && *e == '0'); }
+    if (!on) return 0;
+    if (!s_pace.started) {
+        pthread_t t; if (pthread_create(&t, NULL, vk_pace_main, NULL) != 0) { on = 0; return 0; }
+        pthread_detach(t); s_pace.started = 1;
+    }
+    const uint64_t now = ps3_ft_now();
+    if (s_pace.last_call) {
+        uint64_t d = now - s_pace.last_call; if (d > 100000000ull) d = 100000000ull;
+        s_pace.ema = s_pace.ema ? (s_pace.ema * 7 + d) / 8 : d;
+    }
+    s_pace.last_call = now;
+    uint64_t half = s_pace.ema / 2; if (half < 8000000ull) half = 8000000ull; if (half > 33000000ull) half = 33000000ull;
+    pthread_mutex_lock(&s_pace.mu);
+    if (s_pace.pending) vk_pace_present_now(s_pace.idx);   /* never out of order */
+    s_pace.idx = idx; s_pace.due = now + half; s_pace.pending = 1;
+    pthread_cond_broadcast(&s_pace.cv);
+    pthread_mutex_unlock(&s_pace.mu);
+    return 1;
+}
+
+/* The generated frame into swapchain image `mid` (acquired by the caller), with the counter, left in PRESENT_SRC. */
+static void vk_fg_blit_mid(u32 mid)
+{
+    vk_img_barrier(s_vk.sc_images[mid], VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                   0, VK_ACCESS_TRANSFER_WRITE_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    VkImageBlit bl = { .srcSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .srcOffsets = { { 0, 0, 0 }, { (int32_t)s_vk.width, (int32_t)s_vk.height, 1 } },
+        .dstSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+        .dstOffsets = { { 0, 0, 0 }, { (int32_t)s_vk.sc_extent.width, (int32_t)s_vk.sc_extent.height, 1 } } };
+    if (vk_fsr_enabled() && s_vk.sc_extent.width > s_vk.width) {   /* vk fsr: the generated frame upscaled the same way */
+        vk_img_barrier(s_fg.out.img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL, VK_ACCESS_SHADER_WRITE_BIT,
+                       VK_ACCESS_SHADER_READ_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT);
+        if (vk_fsr_apply(1, s_fg.out.img, s_fg.out.view, s_vk.sc_images[mid]) == 0) goto fsr_done;
+        vk_img_barrier(s_fg.out.img, VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, 0, VK_ACCESS_TRANSFER_READ_BIT,
+                       VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+    }
+    pvkCmdBlitImage(s_vk.cmd, s_fg.out.img, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, s_vk.sc_images[mid], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL,
+                    1, &bl, VK_FILTER_LINEAR);
+fsr_done:
+    if (!vk_overlay_draw(mid))
+        vk_img_barrier(s_vk.sc_images[mid], VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR,
+                       VK_ACCESS_TRANSFER_WRITE_BIT, 0, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+}
+
+/* fg dump (debug, 2026-11-11): PS3_FG_DUMP=<prefix> writes the PRESENTED pictures -- the swapchain images exactly as
+ * they go to the screen, after FSR / LOOK / the counter -- for the generated frame and for the real frame:
+ *   <prefix>.<present>.a_gen.ppm      generated frame, the difference guard did not run for this pair
+ *   <prefix>.<present>.a_gen_s0.ppm   generated frame, guard ran, decision 0 (the warp / network picture)
+ *   <prefix>.<present>.a_gen_s1.ppm   generated frame, guard ran, decision 1 (guard.comp copied the next real frame)
+ *   <prefix>.<present>.a_empty.ppm    a generated-frame image went up with nothing written to it
+ *   <prefix>.<present>.b_real.ppm     the real frame presented after it
+ * PS3_FG_DUMP_SKIP=<n> presents skipped first (default 0), PS3_FG_DUMP_N=<n> presents dumped (default 60, then off),
+ * PS3_FG_DUMP_HALF=1 half size. A dumped present waits for the GPU (slow by design: debug only). One "fg dump:" line
+ * per dumped present with the guard's decision and the pair's difference. Works with frame generation off too
+ * (b_real only), so FG off / FG on / guard on can be compared picture by picture on the BC-250. */
+static struct {
+    int on; const char* prefix; u32 skip, left, half, seen, pending, w, h, mid_kind, present;
+    vk_buffer rb; uint32_t g_count, g_rel_sum;
+} s_fgd = { .on = -1 };
+static void vk_fgd_record(u32 mid, int mid_written, u32 idx)
+{
+    if (s_fgd.on < 0) {
+        const char* e = getenv("PS3_FG_DUMP"); s_fgd.prefix = e; s_fgd.on = e && *e && s_fgd_sc_src;
+        e = getenv("PS3_FG_DUMP_SKIP"); s_fgd.skip = e && *e ? (u32)strtoul(e, NULL, 10) : 0u;
+        e = getenv("PS3_FG_DUMP_N"); s_fgd.left = e && *e ? (u32)strtoul(e, NULL, 10) : 60u;
+        e = getenv("PS3_FG_DUMP_HALF"); s_fgd.half = e && *e == '1';
+        if (s_fgd.on) VK_LOG("fg dump: on (%s.<present>.{a_gen*,b_real}.ppm, skip %u presents, then %u presents%s)\n",
+                             s_fgd.prefix, s_fgd.skip, s_fgd.left, s_fgd.half ? ", half size" : "");
+    }
+    s_fgd.present++;
+    if (!s_fgd.on || s_fgd.pending || !s_fgd.left || s_fgd.seen++ < s_fgd.skip) return;
+    const u32 W = s_vk.sc_extent.width, H = s_vk.sc_extent.height;
+    const VkDeviceSize one = (VkDeviceSize)W * H * 4u;
+    if (s_fgd.rb.size < 2u * one) {
+        if (s_fgd.rb.buf) vk_destroy_buffer(&s_fgd.rb);
+        if (vk_create_readback_buffer(&s_fgd.rb, 2u * one, VK_BUFFER_USAGE_TRANSFER_DST_BIT)) {
+            memset(&s_fgd.rb, 0, sizeof s_fgd.rb); s_fgd.on = 0; VK_LOG("fg dump: off (no readback buffer)\n"); return; }
+    }
+    const u32 im[2] = { mid, idx };
+    for (int i = 0; i < 2; i++) {
+        if (im[i] == UINT32_MAX) continue;
+        const VkImage sc = s_vk.sc_images[im[i]];
+        /* the image is in PRESENT_SRC (left there by the blit / FSR / counter): keep its contents, copy, put it back */
+        vk_img_barrier(sc, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_ACCESS_MEMORY_WRITE_BIT,
+                       VK_ACCESS_TRANSFER_READ_BIT, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, VK_PIPELINE_STAGE_TRANSFER_BIT);
+        VkBufferImageCopy rg = { .bufferOffset = i ? one : 0, .imageSubresource = { VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1 },
+                                 .imageExtent = { W, H, 1 } };
+        pvkCmdCopyImageToBuffer(s_vk.cmd, sc, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, s_fgd.rb.buf, 1, &rg);
+        vk_img_barrier(sc, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR, VK_ACCESS_TRANSFER_READ_BIT, 0,
+                       VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT);
+    }
+    VkBufferMemoryBarrier host = { .sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT,
+        .dstAccessMask = VK_ACCESS_HOST_READ_BIT, .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED,
+        .buffer = s_fgd.rb.buf, .offset = 0, .size = VK_WHOLE_SIZE };
+    pvkCmdPipelineBarrier(s_vk.cmd, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 0, NULL, 1, &host, 0, NULL);
+    s_fgd.pending = 1; s_fgd.w = W; s_fgd.h = H; s_fgd.left--;
+    s_fgd.mid_kind = mid == UINT32_MAX ? 0u : mid_written ? 1u : 2u;
+}
+static void vk_fgd_write(const unsigned char* px, const char* tag)
+{
+    char path[600]; snprintf(path, sizeof path, "%s.%05u.%s.ppm", s_fgd.prefix, s_fgd.present, tag);
+    FILE* f = fopen(path, "wb"); if (!f) { VK_LOG("fg dump: cannot open %s\n", path); return; }
+    const u32 sc = s_fgd.half ? 2u : 1u, w = s_fgd.w / sc, h = s_fgd.h / sc;
+    const int bgr = s_sc_fmt == VK_FORMAT_B8G8R8A8_UNORM || s_sc_fmt == VK_FORMAT_B8G8R8A8_SRGB;
+    unsigned char* row = (unsigned char*)malloc((size_t)w * 3u);
+    fprintf(f, "P6\n%u %u\n255\n", w, h);
+    for (u32 y = 0; y < h && row; y++) {
+        const unsigned char* s = px + (size_t)(y * sc) * s_fgd.w * 4u;
+        for (u32 x = 0; x < w; x++) {
+            const unsigned char* q = s + (size_t)x * sc * 4u;
+            row[x * 3] = bgr ? q[2] : q[0]; row[x * 3 + 1] = q[1]; row[x * 3 + 2] = bgr ? q[0] : q[2];
+        }
+        fwrite(row, 1, (size_t)w * 3u, f);
+    }
+    free(row); fclose(f);
+}
+/* After the frame's submission: wait for it, write the files. */
+static void vk_fgd_collect(void)
+{
+    if (!s_fgd.pending) return;
+    s_fgd.pending = 0;
+    pvkWaitForFences(s_vk.device, 1, &s_vk.fence, VK_TRUE, UINT64_MAX);
+    vk_invalidate(&s_fgd.rb);
+    const unsigned char* px = (const unsigned char*)s_fgd.rb.ptr;
+    const VkDeviceSize one = (VkDeviceSize)s_fgd.w * s_fgd.h * 4u;
+    const char* gt = "a_gen"; char note[128] = "guard did not run";
+    if (s_fgg.buf.ptr) {   /* this frame is complete and the next one is not submitted yet: B holds this pair's decision */
+        const volatile vk_fgg_buf* b = (const volatile vk_fgg_buf*)s_fgg.buf.ptr;
+        const uint32_t c = b->count, st = b->state, rs = b->rel_sum;
+        if (c != s_fgd.g_count) {
+            gt = st ? "a_gen_s1" : "a_gen_s0";
+            if (c - s_fgd.g_count == 1u) snprintf(note, sizeof note, "guard decision %u, difference %.3f", st, (double)(rs - s_fgd.g_rel_sum) / 10000.0);
+            else snprintf(note, sizeof note, "guard decision %u", st);
+        }
+        s_fgd.g_count = c; s_fgd.g_rel_sum = rs;
+    }
+    if (s_fgd.mid_kind == 2u) gt = "a_empty";
+    if (s_vk.sc_count && s_sc_fmt != VK_FORMAT_B8G8R8A8_UNORM && s_sc_fmt != VK_FORMAT_R8G8B8A8_UNORM &&
+        s_sc_fmt != VK_FORMAT_B8G8R8A8_SRGB && s_sc_fmt != VK_FORMAT_R8G8B8A8_SRGB) {
+        static int told; if (!told++) VK_LOG("fg dump: swapchain format %d is not 8-bit RGBA/BGRA: the files are its raw bytes\n", (int)s_sc_fmt); }
+    if (s_fgd.mid_kind) vk_fgd_write(px, gt);
+    vk_fgd_write(px + one, "b_real");
+    VK_LOG("fg dump: present %u: %s (%s), b_real\n", s_fgd.present, s_fgd.mid_kind ? gt : "no generated frame",
+           s_fgd.mid_kind ? note : "interval hold, first pair or frame generation off");
+}
+
 /* Blit the offscreen target into the next swapchain image and present it. */
 static void vk_present_window(void)
