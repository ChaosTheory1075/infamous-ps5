+        {"it", CELL_SYSUTIL_LANG_ITALIAN}, {"nl", CELL_SYSUTIL_LANG_DUTCH},
+        {"pt", CELL_SYSUTIL_LANG_PORTUGUESE_PT}, {"pt-pt", CELL_SYSUTIL_LANG_PORTUGUESE_PT},
+        {"ru", CELL_SYSUTIL_LANG_RUSSIAN}, {"ko", CELL_SYSUTIL_LANG_KOREAN},
