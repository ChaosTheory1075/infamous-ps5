+ * bound them as before: 64 depth copies, 32 depth->RGBA8 copies). 0 = release as before. */
+static int eng_zcopy_keep(void)
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("PS3RECOMP_ENG_ZCOPY_KEEP"); v = !(e && *e == '0'); }
+    return v;
+}
+static unsigned s_tg_zcopy;   /* tg rebase: R32F depth-copy releases left to the backend (per 300 frames) */
+
+/* tg rebase: the freed-handle record (see rsx_draw_engine.h). One writer at a time -- the thread running the backend;
+ * the async proxy hands the backend between its worker and the RSX thread under s_mu, which orders their writes --
+ * and any number of readers with their own cursor. A reader copies entries, then re-reads the end: if the writer
+ * may have lapped the first entry it read, the batch is reported lost (seqlock-style). */
+/* BFX_BEGIN -- t35b: this block up to BFX_END is compiled as is by work/agent_t35fix/harness (bfx_test.c). */
+/* PS3RECOMP_ENG_FREED_NOTE (t35b: default 0; =1 on): the backend records the frees below and the engine (and the async
+ * proxy's view cache) read that record at their safe points and forget every cached copy / template / light input under
+ * a freed number (eng_bf_drain, with the draw-fast templates). 0 = nothing is recorded or read (the old behaviour).
+ * Default off: with it on, every colour / depth target replacement flushes all draw-fast templates and drops the GPU-light
+ * inputs taken from that target (eng_bf_target_gone) -- replay share / fps cost not measured yet (t35 review F3).
+ * Read by the backend's thread too (the proxy's worker), hence the atomics. */
+static int eng_bf_on(void)
+{
+    static int v = -1;
+    int r = __atomic_load_n(&v, __ATOMIC_RELAXED);
+    if (__builtin_expect(r < 0, 0)) {
+        const char* e = getenv("PS3RECOMP_ENG_FREED_NOTE"); r = e && *e == '1';
+        __atomic_store_n(&v, r, __ATOMIC_RELAXED);
+    }
+    return r;
+}
+#define ENG_BF_N 1024u
+static u32 s_bf_ring[ENG_BF_N];
+static u32 s_bf_end;   /* entries ever recorded (atomic) */
+void rsx_be_note_freed(u32 h)
+{
+    if (!h || !eng_bf_on()) return;
+    const u32 w = __atomic_load_n(&s_bf_end, __ATOMIC_RELAXED);
+    __atomic_store_n(&s_bf_ring[w & (ENG_BF_N - 1u)], h, __ATOMIC_RELAXED);
+    __atomic_store_n(&s_bf_end, w + 1u, __ATOMIC_RELEASE);
+}
+u32 rsx_be_freed_cursor(void) { return __atomic_load_n(&s_bf_end, __ATOMIC_ACQUIRE); }
+/* t35b: ">= ENG_BF_N" (was "> ENG_BF_N"): with end - cursor == ENG_BF_N the writer's NEXT entry (being stored, end
+ * not yet advanced) goes into the slot of the first entry this reader copies. */
+u32 rsx_be_freed_poll(u32* cursor, u32* out, u32 max)
+{
+    const u32 w = __atomic_load_n(&s_bf_end, __ATOMIC_ACQUIRE);
+    u32 r = *cursor;
+    if (r == w) return 0;
+    if (w - r >= ENG_BF_N) { *cursor = w; return RSX_BE_FREED_LOST; }
+    u32 n = 0;
+    while (r != w && n < max) { out[n++] = __atomic_load_n(&s_bf_ring[r & (ENG_BF_N - 1u)], __ATOMIC_RELAXED); r++; }
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    const u32 w2 = __atomic_load_n(&s_bf_end, __ATOMIC_RELAXED);
+    if (w2 - *cursor >= ENG_BF_N) { *cursor = w2; return RSX_BE_FREED_LOST; }
+    *cursor = r;
+    return n;
+}
+/* t35b (F1): the engine's read cursor, and for each texture unit of the draw being resolved the cursor at the moment
+ * that unit's handle was settled (eng_bf_unit_done). A free recorded at position p of the handle a unit holds means
+ * that unit's object died after the unit got it iff p >= the unit's position -- the number alone cannot say: a copy
+ * request of a later unit that evicts unit M's copy X is handed X again for its new copy (lowest free first), so X is
+ * then both unit M's stale handle and unit N's fresh one. Unit N settled after eng_tg_new read the free (its position
+ * is past it); unit M settled before the free was recorded. A handle made without a record read in between (a
+ * surface_view) can look stale when it is not: one extra resolve pass, which first reads the record to its end. */
+static u32 s_bf_cur; static int s_bf_started;
+static u32 s_bf_lost_at;   /* the record's end when an overflow was last counted (counted once per overflow) */
+static u32 s_bf_upos[RSX_BE_MAX_TEXTURES], s_bf_vpos[RSX_BE_MAX_VERTEX_TEXTURES];
+static inline void eng_bf_unit_done(u32* pos, u32 u) { if (eng_bf_on()) pos[u] = s_bf_cur; }
+#define ENG_BF_SCAN_LOST 0xFFFFFFFFu
+/* The entries [from, end) WITHOUT consuming them, against units `mask` of h[] (n units): the units whose handle was
+ * freed at or after their own position. ENG_BF_SCAN_LOST when the writer may have lapped `from` (seqlock check as
+ * rsx_be_freed_poll). Draw resolution's own record reads (eng_tg_new, several call sites) cannot hide anything here. */
+static u32 eng_bf_scan(u32 from, const u32* h, u32 mask, const u32* pos, u32 n)
+{
+    const u32 w = __atomic_load_n(&s_bf_end, __ATOMIC_ACQUIRE);
+    if (w == from || !mask) return 0;
+    if (w - from >= ENG_BF_N) return ENG_BF_SCAN_LOST;
+    u32 stale = 0;
+    for (u32 p = from; p != w; p++) {
+        const u32 f = __atomic_load_n(&s_bf_ring[p & (ENG_BF_N - 1u)], __ATOMIC_RELAXED);
+        for (u32 u = 0; u < n; u++)
+            if (((mask >> u) & 1u) && h[u] == f && (int32_t)(p - pos[u]) >= 0) stale |= 1u << u;
+    }
+    __atomic_thread_fence(__ATOMIC_ACQUIRE);
+    if (__atomic_load_n(&s_bf_end, __ATOMIC_RELAXED) - from >= ENG_BF_N) return ENG_BF_SCAN_LOST;
+    return stale;
+}
+/* BFX_END */
+
+static int eng_occ_counting(void);   /* occ query: a ZPASS pixel count is open (defined with s_occ) */
+/* ba replay op: the bias eng_apply_depth_bias sends (0 = no set_depth_bias: nothing sent); the call itself is the caller's. */
+/* ovl class0 (PS3RECOMP_ENG_OVERLAY_BIAS_CLASS0=1; default 0 = today): an overlay that gets the overlay bias and writes
+ * the stencil class as ALWAYS / REPLACE / ref 0 / write mask M is drawn with stencil EQUAL, ref 0, compare mask M:
+ * it lands only where the class bits are already 0 (its world base surface: REPLACE 0 over 0 changes nothing) and
+ * is rejected on character pixels (class 0x80 / 0xC0), where the PS3's unbiased depth test fails. Without it the
+ * biased 3-target overlays drawn after the body passed LEQUAL over Cole and wrote class 0 = dark bands / blocks
+ * (runs ovl0 vs sref_a, sd10_on171). Stencil func and compare mask are baked into the pipeline from the render state
+ * (rsx_vulkan_backend.c vk_gcm_stencil_face), so only the state handed to eng_pipeline_get changes: the pipeline key
+ * sees it, the draw-fast templates keep the guest state and replay the recorded pipeline. */
+static int s_ovl_cls = -1, s_ovl_applied, s_ovl_probe;
+static u32 s_oc_n, s_oc_m;
+static int eng_ovl_cls_on(void)
+{
+    if (__builtin_expect(s_ovl_cls < 0, 0)) { const char* e = getenv("PS3RECOMP_ENG_OVERLAY_BIAS_CLASS0"); s_ovl_cls = e && (*e == '1' || *e == '2') ? *e - '0' : 0;
+        if (s_ovl_cls) fprintf(stderr, "[ovl class0] on: biased overlays that write stencil class 0 test it (EQUAL 0)\n"); }
+    return s_ovl_cls;
+}
+static int eng_ovl_class0_match(const rsx_be_render_state* rs)
+{
+    /* fail / zfail must be KEEP: under ALWAYS the fail op never ran; under EQUAL it runs on every rejected pixel. */
+    if (!rs->stencil_enable || rs->s_func != 0x0207u || rs->s_zpass != 0x1E01u || !(rs->s_write_mask & 0xFFu) ||
+        rs->s_fail != 0x1E00u || rs->s_zfail != 0x1E00u ||
+        (rsx_dsp_reg(&g.rsx, M_STENCIL_FUNC_REF) & 0xFFu) != 0u) return 0;
+    if (rs->stencil_two_sided && (rs->bs_func != 0x0207u || rs->bs_zpass != 0x1E01u ||
+                                  rs->bs_fail != 0x1E00u || rs->bs_zfail != 0x1E00u ||
+                                  (rsx_dsp_reg(&g.rsx, 0x0354u) & 0xFFu) != 0u)) return 0;
+    if (s_ovl_cls == 2 && !(rs->s_write_mask & 0x80u)) return 0;   /* =2: the character bit must be one it writes */
+    return 1;
+}
+static int eng_depth_bias_args(u32 zeta_offset, const rsx_be_render_state* rs, u32 n_targets, float zb[2]);
+/* The render state the pipeline is built from: rs itself, or (switch on, overlay bias applied, class-0 writer) a
+ * copy in *tmp with the class test. */
+static const rsx_be_render_state* eng_ovl_class0_rs(const rsx_be_render_state* rs, u32 zeta_offset, u32 n_targets,
+                                                    rsx_be_render_state* tmp)
+{
+    if (__builtin_expect(!eng_ovl_cls_on(), 1)) return rs;
+    float zb[2];
+    s_ovl_probe = 1; s_ovl_applied = 0;
+    eng_depth_bias_args(zeta_offset, rs, n_targets, zb);
+    s_ovl_probe = 0;
+    if (!s_ovl_applied || !eng_ovl_class0_match(rs)) return rs;
+    *tmp = *rs;
+    tmp->s_func = 0x0202u;                        /* EQUAL, ref 0 (the guest's, dynamic) */
+    /* front and back share it in the pipeline. =2: only the character bit 0x80 (classes 0x80 / 0xC0) rejects; world
+     * items carry other classes too (0x20 on 3-target world draws, sdump7 d 1606-2292) and keep their overlays. */
+    tmp->s_func_mask = s_ovl_cls == 2 ? 0x80u : (rs->s_write_mask & 0xFFu);
+    if (rs->stencil_two_sided) tmp->bs_func = 0x0202u;
+    return tmp;
+}
+static int eng_depth_bias_args(u32 zeta_offset, const rsx_be_render_state* rs, u32 n_targets, float zb[2])
+{
+    s_ovl_applied = 0;   /* ovl class0 */
+    if (!g.be->set_depth_bias) return 0;
+    if (__builtin_expect(__atomic_load_n(&s_poly_offset, __ATOMIC_RELAXED) < 0, 0)) {
+        const char* e = getenv("PS3RECOMP_ENG_POLY_OFFSET");
+        const int v = e ? atoi(e) : 1;
+        __atomic_store_n(&s_poly_offset, v > 0 ? v : 0, __ATOMIC_RELAXED);
+        ps3_toggle_watch(PS3T_ENG_POLY_OFFSET, eng_poly_offset_set);
+    }
+    static float units_k = -1.0f; static int log_on = -1;
+    if (units_k < 0.0f) { const char* e = getenv("PS3RECOMP_ENG_POLY_OFFSET_UNITS");
+        units_k = e ? (float)atof(e) : 1.0f; if (units_k < 0.0f) units_k = 0.0f;
+        e = getenv("PS3RECOMP_ENG_POLY_OFFSET_LOG"); log_on = e && *e == '1'; }
+    const u32 en = rsx_dsp_reg(&g.rsx, M_POLY_OFFSET_FILL) & 1u;
+    const u32 sr = rsx_dsp_reg(&g.rsx, M_POLY_OFFSET_SCALE), br = rsx_dsp_reg(&g.rsx, M_POLY_OFFSET_BIAS);
+    float slope = 0.0f, constant = 0.0f;
+    const int mode = __atomic_load_n(&s_poly_offset, __ATOMIC_RELAXED);
+    if (en && mode) {
+        memcpy(&slope, &sr, 4); memcpy(&constant, &br, 4);
+        if (slope != slope) slope = 0.0f;
+        if (constant != constant) constant = 0.0f;
+        constant *= units_k * (float)mode;   /* mode > 1: diagnostic multiple */
+    }
+    {   /* eng overlay bias (2026-11-11): PS3RECOMP_ENG_OVERLAY_BIAS=<units> (default 0 = off). inFAMOUS 2 draws its overlay
+         * layers (decals, tram rails, trims, car detail) with depth test LESS/LEQUAL, no depth write and NO polygon offset:
+         * it separates them from the surface below only by scaling the projection's z column by ~0.9999998, 1.6-3 steps
+         * of the RSX's 24-bit depth. Float vertex math plus a float depth buffer can be off by more than that, and a
+         * whole layer flips. <units> is added as a constant depth bias (in depth steps; negative = towards the camera) to
+         * exactly those draws: -8 restores the margin.
+         * Units (t35 stack): the constant goes out through set_depth_bias like the guest's polygon offset. On today's
+         * D32_SFLOAT targets Vulkan scales it by 2^(e-23), e = the exponent of the primitive's largest depth: one unit is
+         * a 24-bit step (2^-24) only for depths in [0.5, 1), 2^-25 in [0.25, 0.5), and so on. With
+         * PS3RECOMP_VK_DEPTH_BIAS_D24=1 (VK_EXT_depth_bias_control, FORCE_UNORM) one unit is 2^-24 at every depth, as
+         * written above: the same bias for overlays at depth >= 0.5 (most of the street), larger by 2x per octave
+         * nearer than that. Retune <units> with that switch on if near-camera overlays change. */
+        /* PS3RECOMP_ENG_OVERLAY_BIAS_MINRT=<n> (default 0 = every such draw): only draws into >= n colour
+         * targets that write some colour, outside an occlusion count. The overlays are G-buffer draws (inFAMOUS 2 and
+         * FoB: 3 targets, inFAMOUS 1: 2); what else matches the depth rule draws into one target: light volumes,
+         * cascade stencil marks, glass, particles, glare proxies (colour off, counted: the bias would raise their
+         * pixel counts). 2 keeps the overlays of all three games and nothing else seen in the real PS3 frames.
+         * PS3RECOMP_ENG_OVERLAY_BIAS_LOG=1: the first 48 distinct matching states, applied or not. */
+        static float ovl = 1e30f; static int ovl_minrt, ovl_log;
+        if (ovl == 1e30f) { const char* e = getenv("PS3RECOMP_ENG_OVERLAY_BIAS");
+            const char* m = getenv("PS3RECOMP_ENG_OVERLAY_BIAS_MINRT"); ovl_minrt = m ? atoi(m) : 0;
+            m = getenv("PS3RECOMP_ENG_OVERLAY_BIAS_LOG"); ovl_log = m && *m == '1';
+            (void)eng_ovl_cls_on();   /* ovl class0: PS3RECOMP_ENG_OVERLAY_BIAS_CLASS0 */
+            ovl = e ? (float)atof(e) : 0.0f; }
+        if (ovl != 0.0f && !(en && mode) && rs->depth_test && !rs->depth_write && (rs->depth_func == 0x201u || rs->depth_func == 0x203u)) {
+            const int cw = (rs->color_mask | rs->color_mask_mrt) != 0;
+            const int occ = eng_occ_counting();
+            const int ok = ovl_minrt <= 0 || ((int)n_targets >= ovl_minrt && cw && !occ);
+            if (ok) { constant = ovl; s_ovl_applied = 1;   /* ovl class0: count real draws, not the pipeline probe */
+                      if (__builtin_expect(s_ovl_cls > 0 && !s_ovl_probe, 0)) { s_oc_n++; if (eng_ovl_class0_match(rs)) s_oc_m++; } }
+            if (ovl_log) {
+                static u32 seen[48][6]; static int nseen;
+                const u32 key[6] = { zeta_offset, n_targets, rs->depth_func, rs->color_mask, rs->stencil_enable, (u32)(ok | occ << 1) };
+                int k = 0; for (; k < nseen; k++) if (!memcmp(seen[k], key, sizeof key)) break;
+                if (k == nseen && nseen < 48) { memcpy(seen[nseen++], key, sizeof key);
+                    fprintf(stderr, "[ovl bias] %s: zeta 0x%08X targets %u func 0x%X cmask 0x%08X/0x%X stencil %u blend %u occ %d (frame %u)\n",
+                            ok ? "biased" : "skipped", zeta_offset, n_targets, rs->depth_func, rs->color_mask, rs->color_mask_mrt,
+                            rs->stencil_enable, rs->blend_enable, occ, g.frames); }
+            }
+        }
+    }
+    if (log_on && rs->depth_write) {
+        /* Which depth targets the offset draws write, how they cull. */
+        static u32 seen[64][4]; static int nseen;
+        const u32 cull = rs->cull_enable ? rs->cull_face : 0;
+        int k = 0; for (; k < nseen; k++)
+            if (seen[k][0] == zeta_offset && seen[k][1] == (en ? sr : 0xFFFFFFFFu) && seen[k][2] == (en ? br : 0) && seen[k][3] == cull) break;
+        if (k == nseen && nseen < 64) { seen[nseen][0] = zeta_offset; seen[nseen][1] = en ? sr : 0xFFFFFFFFu;
+            seen[nseen][2] = en ? br : 0; seen[nseen][3] = cull; nseen++;
+            float fs, fb; memcpy(&fs, &sr, 4); memcpy(&fb, &br, 4);
+            fprintf(stderr, "[rsx engine] zwrite zeta 0x%08X cull 0x%X poly offset %s scale %g bias %g\n",
+                    zeta_offset, cull, en ? "ON" : "off", (double)fs, (double)fb); }
+    }
+    zb[0] = constant; zb[1] = slope;
+    return 1;
+}
+static float s_ro_zb[2]; static int s_ro_zb_on;   /* ba replay op: the last bias eng_apply_depth_bias sent (the full path's) */
+static void eng_apply_depth_bias(u32 zeta_offset, const rsx_be_render_state* rs, u32 n_targets)
+{
+    float zb[2];
+    s_ro_zb_on = eng_depth_bias_args(zeta_offset, rs, n_targets, zb);
+    if (s_ro_zb_on) { s_ro_zb[0] = zb[0]; s_ro_zb[1] = zb[1]; g.be->set_depth_bias(g.be->user, zb[0], zb[1]); }
+}
+
+static void eng_apply_depth_clip(u32 zeta_offset, const rsx_be_render_state* rs, float vp_sy)
+{
+    static int log_on = -1;
+    if (__builtin_expect(log_on < 0, 0)) { const char* e = getenv("PS3RECOMP_ENG_POLY_OFFSET_LOG"); log_on = e && *e == '1'; }
+    const int hook = g.be->set_depth_clamp != NULL;
+    if (!hook && !log_on) return;   /* vk depth clamp: without the hook only the log below runs (no switch is read) */
+    if (hook && __builtin_expect(__atomic_load_n(&s_depth_clamp, __ATOMIC_RELAXED) < 0, 0)) {
+        const char* e = getenv("PS3RECOMP_ENG_DEPTH_CLAMP");
+        __atomic_store_n(&s_depth_clamp, (e && *e == '2') ? 2 : !(e && *e == '0'), __ATOMIC_RELAXED);
+        ps3_toggle_watch(PS3T_ENG_DEPTH_CLAMP, eng_depth_clamp_set);
+        e = getenv("PS3RECOMP_ENG_CLAMP_CULL_FLIP");
+        __atomic_store_n(&s_clamp_cull_flip, e && atoi(e) > 0, __ATOMIC_RELAXED);
+        ps3_toggle_watch(PS3T_ENG_CLAMP_CULL_FLIP, eng_clamp_cull_flip_set);
+    }
+    const u32 v = rsx_dsp_reg(&g.rsx, 0x1D78);
+    int mode = __atomic_load_n(&s_depth_clamp, __ATOMIC_RELAXED);
+    if (mode < 0) mode = 1;   /* no hook: the default decode, for the log */
+    const int clamp = mode == 2 ? (v & 0xF0u) != 0 : mode && ((v & 0xF0u) != 0 || (v & 0xFu) == 0);
+    if (log_on) {
+        static u32 seen[64][3]; static int nseen;
+        const u32 cf = (rs->cull_enable ? rs->cull_face : 0) | (rs->front_face << 16) | (vp_sy < 0.0f ? 0x80000000u : 0);
+        int k = 0; for (; k < nseen; k++) if (seen[k][0] == zeta_offset && seen[k][1] == v && seen[k][2] == cf) break;
+        if (k == nseen && nseen < 64) { seen[nseen][0] = zeta_offset; seen[nseen][1] = v; seen[nseen][2] = cf; nseen++;
+            fprintf(stderr, "[rsx engine] zeta 0x%08X ZMIN_MAX_CONTROL 0x%X -> depth %s%s; cull 0x%X front 0x%X viewport y %s\n",
+                    zeta_offset, v, clamp ? "clamp" : "clip",
+                    hook ? (clamp ? " (host: clamped)" : "") : (clamp ? " (host: CLIPPED, the backend has no depth clamp)" : ""),
+                    rs->cull_enable ? rs->cull_face : 0, rs->front_face, vp_sy < 0.0f ? "-" : "+"); }
+    }
+    if (hook) g.be->set_depth_clamp(g.be->user, clamp);
+}
+
+/* ba replay op (PS3_BA_REPLAY_OP; rsx_ba_replayop.h): a replay's binds. s_eng_ro = the proxy's working mode (0 unless
+ * g.be is the async proxy with PS3_BA_DEDUP on): 0 = the replays make today's calls inline and this is not reached.
+ * The call sequence is today's replay sequence (targets, pipeline, vertex range, fragment constants, textures, vertex
+ * textures, hud, viewport, scissor, stencil ref, depth bias, depth clamp); =1 leaves out the eight template binds when
+ * the tag's epoch is current, and the bias when it also equals the tagged one -- all of them calls the proxy's dedup
+ * would drop (rsx_ba_replayop.h). After the last state call the template is tagged again. vt == NULL: the draw-fast
+ * templates' all-zero vertex units (no vertex textures). slot: -1 draw-fast, 0..N-1 draw-fast N, -2 caster-fast. */
+static int s_eng_ro;
+static const char* const s_ro_kind[RO_K_N] = { "bind_targets", "bind_pipeline", "bind_ps_constants", "bind_textures",
+    "bind_vertex_textures", "set_viewport", "set_scissor", "set_stencil_ref", "set_depth_bias" };
+static __attribute__((noinline, cold)) void eng_ro_miss(int kind, int slot)
+{
+    rsx_ba_ro* const r = &g_rsx_ba_ro;
+    r->miss++;
+    if (r->miss_logged++ < 8u)
+        fprintf(stderr, "[ba replayop] verify: NOT DROPPED %s at draw %u frame %u, template %s %d (epoch said skip)\n",
+                s_ro_kind[kind], g.guest_draws, g.frames, slot == -2 ? "caster" : slot == -1 ? "draw-fast" : "draw-fast-N slot", slot);
+}
+static void eng_ro_binds(rsx_ro_tag* ro, int slot, const u32* handles, u32 nt, u32 depth, u32 pipeline,
+                         u32 vpc_lo, u32 vpc_n, const float* xf, u32 xf_bytes, const u8* fp_cb, u32 fp_bytes,
+                         const u32* tex, const rsx_be_sampler_desc* smp, u32 tex_mask,
+                         const u32* vt, const rsx_be_sampler_desc* vs, u32 vt_mask, int hud, u32 hud_w,
+                         float W, float H, const u32* sc, u32 sref, u32 zeta, const rsx_be_render_state* prs, float vp_sy,
+                         int texnew)   /* dt texdelta: tex holds re-resolved units the dedup memory has not seen */
+{
+    rsx_ba_ro* const r = &g_rsx_ba_ro;
+    float zb[2] = { 0.0f, 0.0f };
+    const int zon = eng_depth_bias_args(zeta, prs, nt, zb);   /* what today's eng_apply_depth_bias sends */
+    const int match = rsx_ro_match(ro);
+    const int zsame = match && rsx_ro_zsame(ro, zon, zb);
+    r->replays++;
+    if (match) { r->sets++; r->saved += 8u - (u32)(texnew != 0) + (u32)(zon && zsame); }
+    if (match && s_eng_ro == 1) {
+        g.be->bind_vs_constants_range(g.be->user, g.rsx.constants, vpc_lo, vpc_n, xf, xf_bytes, ENG_VP_CB_BYTES);
+        /* dt texdelta: the other seven kinds still hold this template's bytes (only DD_TEX changes): they stay skipped */
