#version 450
// FSR 1 RCAS (robust contrast adaptive sharpening), after AMD FidelityFX FSR 1.0 FsrRcasF (MIT), full precision.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform PC { ivec2 in_size; ivec2 out_size; vec4 con0; float sharp; } pc;

vec3 T(ivec2 p) { return texelFetch(src, clamp(p, ivec2(0), pc.out_size - 1), 0).rgb; }
float L(vec3 c) { return c.b * 0.5 + (c.r * 0.5 + c.g); }
const float LIMIT = 0.25 - 1.0 / 16.0;

void main()
{
    ivec2 sp = ivec2(gl_GlobalInvocationID.xy);
    if (sp.x >= pc.out_size.x || sp.y >= pc.out_size.y) return;
    //    b
    //  d e f
    //    h
    vec3 b = T(sp + ivec2(0, -1)), d = T(sp + ivec2(-1, 0)), e = T(sp), f = T(sp + ivec2(1, 0)), h = T(sp + ivec2(0, 1));
    float bL = L(b), dL = L(d), eL = L(e), fL = L(f), hL = L(h);
    float nz = 0.25 * bL + 0.25 * dL + 0.25 * fL + 0.25 * hL - eL;
    float rng = max(max(max(bL, dL), max(eL, fL)), hL) - min(min(min(bL, dL), min(eL, fL)), hL);
    nz = clamp(abs(nz) / max(rng, 1.0 / 65536.0), 0.0, 1.0);
    nz = -0.5 * nz + 1.0;
    vec3 mn4 = min(min(b, d), min(f, h)), mx4 = max(max(b, d), max(f, h));
    vec3 hitMin = mn4 / max(4.0 * mx4, vec3(1.0 / 65536.0));
    vec3 hitMax = (1.0 - mx4) / min(4.0 * mn4 - 4.0, vec3(-1.0 / 65536.0));
    vec3 lobeRGB = max(-hitMin, hitMax);
    float lobe = max(-LIMIT, min(max(max(lobeRGB.r, lobeRGB.g), lobeRGB.b), 0.0)) * pc.sharp;
    lobe *= nz;
    vec3 pix = (lobe * (b + d + f + h) + e) / (4.0 * lobe + 1.0);
    imageStore(dst, sp, vec4(clamp(pix, 0.0, 1.0), 1.0));
}
