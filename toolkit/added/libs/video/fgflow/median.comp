#version 450
// fg flow, pass 2: the 3x3 median of the block displacements (each component), as backward motion in uv for
// MihawkGen's mvwarp: next uv minus previous uv = -d / size.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 3, rgba32f) uniform readonly image2D raw;
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D motion;
layout(push_constant) uniform PC { ivec2 size; ivec2 blocks; float lambda; float zero_bias; } pc;
float med9(float v[9])
{
    for (int i = 0; i < 5; i++)
        for (int j = i + 1; j < 9; j++)
            if (v[j] < v[i]) { float t = v[i]; v[i] = v[j]; v[j] = t; }
    return v[4];
}
void main()
{
    const ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    if (b.x >= pc.blocks.x || b.y >= pc.blocks.y) return;
    float xs[9], ys[9];
    int n = 0;
    for (int j = -1; j <= 1; j++)
        for (int i = -1; i <= 1; i++) {
            const vec2 d = imageLoad(raw, clamp(b + ivec2(i, j), ivec2(0), pc.blocks - 1)).xy;
            xs[n] = d.x; ys[n] = d.y; n++;
        }
    const vec2 d = vec2(med9(xs), med9(ys));
    imageStore(motion, b, vec4(-d / vec2(pc.size), 0.0, 0.0));
}
