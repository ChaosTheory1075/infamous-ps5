#version 450
// fg flow, pass 3: the frame at t along the motion field. For output pixel x find the next-frame position u1 with
// u1 - (1 - t) mv(u1) = x (fixed-point iteration, as motion-compensated interpolation does), read the next frame at
// u1 and the previous at u1 - mv. Where the two readings agree they are one surface: mix them at t. Where they do
// not (a wrong vector, an occlusion, a static HUD over a moving background) show the next real frame's own pixel at
// x: a repeat there, never two copies of a thing.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D prev_c;
layout(set = 0, binding = 1) uniform sampler2D next_c;
layout(set = 0, binding = 5) uniform sampler2D motion;
layout(set = 0, binding = 6, rgba8) uniform writeonly image2D outi;
layout(push_constant) uniform PC { ivec2 size; ivec2 blocks; float t; float agree; } pc;
void main()
{
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= pc.size.x || p.y >= pc.size.y) return;
    const vec2 size = vec2(pc.size);
    const vec2 x = (vec2(p) + 0.5) / size;
    const float fwd = 1.0 - pc.t;
    vec2 u1 = x;
    for (int i = 0; i < 4; i++) u1 = x + fwd * textureLod(motion, u1, 0.0).xy;
    const vec2 mv = textureLod(motion, u1, 0.0).xy;
    const float residual = length((u1 - fwd * mv - x) * size);
    const vec2 u0 = u1 - mv;
    const vec3 c1 = textureLod(next_c, u1, 0.0).rgb;
    const vec3 c0 = textureLod(prev_c, u0, 0.0).rgb;
    const vec3 cx = texelFetch(next_c, p, 0).rgb;
    const vec3 dd = abs(c0 - c1);
    const float dis = max(max(dd.r, dd.g), dd.b);
    const bool inside = all(greaterThanEqual(u0, vec2(0.0))) && all(lessThanEqual(u0, vec2(1.0)));
    const float broken = clamp((inside ? 0.0 : 1.0) + smoothstep(0.75, 1.5, residual) +
                               smoothstep(pc.agree * 0.5, pc.agree, dis), 0.0, 1.0);
    /* one motion-compensated sample, never a cross-fade of two frames: where a wrong vector still "agreed" (dark,
     * low-contrast scenes) the old mix(c0, c1, t) showed both frames at once -- the whole-screen doubling */
    imageStore(outi, p, vec4(mix(c1, cx, broken), 1.0));
}
