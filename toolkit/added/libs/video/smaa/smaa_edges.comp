#version 450
#extension GL_GOOGLE_include_directive : require
// vk smaa pass 1: luma edges of the frame.
#include "smaa_common.glsl"
layout(binding = 0) uniform sampler2D color_tex;   // linear
layout(binding = 3, rgba8) uniform writeonly image2D edges_out;
void main() {
  ivec2 pixel; vec2 texcoord;
  if (!SmaaPixel(pixel, texcoord)) return;
  vec4 offset[3];
  SMAAEdgeDetectionVS(texcoord, offset);
  imageStore(edges_out, pixel, vec4(SMAALumaEdgeDetectionPS(texcoord, offset, color_tex), 0.0, 0.0));
}
