#version 450
#extension GL_GOOGLE_include_directive : require
// vk smaa pass 3: each edge pixel blended with its neighbour, into the image EASU reads.
#include "smaa_common.glsl"
layout(binding = 0) uniform sampler2D color_tex;   // linear
layout(binding = 1) uniform sampler2D blend_tex;   // linear
layout(binding = 3, rgba8) uniform writeonly image2D color_out;
void main() {
  ivec2 pixel; vec2 texcoord;
  if (!SmaaPixel(pixel, texcoord)) return;
  vec4 offset;
  SMAANeighborhoodBlendingVS(texcoord, offset);
  imageStore(color_out, pixel, vec4(SMAANeighborhoodBlendingPS(texcoord, offset, color_tex, blend_tex).rgb, 1.0));
}
