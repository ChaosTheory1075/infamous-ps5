/* rsx lightning: LIVE lightning colour (PS3_LIGHTNING_LIVE=1; off by default: nothing below runs and no
 * texture changes). Included by rsx_draw_engine.c just before eng_texture_upload.
 *
 * Cole's lightning is drawn with a fixed set of DXT5 textures (the shipped colour packs' sets: FoB 42, inFAMOUS 2 93,
 * inFAMOUS 1 27 per edition; modsout notes). rsx_lightning_table.h (generated by ltlive notes)
 * holds their run-time keys -- eng_texmod_key over the content hash of the whole mip chain, the key PS3_MODS uses --
 * with their shapes. At texture creation a texture whose (format, width, height) is one of those few shapes is
 * hashed and looked up; one in the table is decoded on the CPU, recoloured with the colour packs' own maths
 * (ltcolor notes, modsout notes) and uploaded as RGBA8 (same levels, sampler and crossbar
 * as the DXT5 upload: both are UNORM, sRGB is the shader's business either way).
 *   class W  colourless fx the game tints per vertex with a pale blue: hue := H, S += 0.80, then x (1, .814, .70),
 *            the tint's pre-compensation, so texture x tint comes out H
 *   class C/H  coloured bolt / glow sets and the HUD karma meter: hue := H, S += 0.25
 *   WHITE  S := 0, V *= 1.15 (W also pre-compensated)
 * The colour is the global g_ps3_lt_hue (0..359, LT_HUE_DEFAULT = the game's own textures, LT_HUE_WHITE,
 * LT_HUE_IDENTITY = decoded and uploaded unchanged: a test of the RGBA8 path). The quick menu (vk_quickmenu.inc,
 * LIGHTNING row, colour wheel) changes it and bumps g_ps3_lt_gen; each cache entry holding a lightning texture
 * remembers the generation it was made with and is made again on its next use, at most PS3_LIGHTNING_PER_FRAME
 * (default 6) a frame, so a change costs no hitch (the rest keep the old colour for a few frames).
 *   PS3_LIGHTNING_LIVE=1          the feature (else inert)
 *   PS3_LIGHTNING_HUE=<0-359|default|white|identity>  start colour (else lightning_hue in the first PS3_QM_INI file)
 *   PS3_LIGHTNING_PER_FRAME=<n>   textures rebuilt a frame after a change (default 6)
 * A texture of a lightning shape whose key is a FILE colour pack's (class P rows: the same textures as the 15 shipped
 * colour packs recoloured them) is left alone and logged once: live colour needs the pack colour set to DEFAULT. */
#include "rsx_lightning_table.h"
/* lt2 (2026-11-14): textures found after the table was generated, same classes and maths; rows LT_N_KEYS + i.
 * Keys by content (eng_texmod_key): byte-identical in the EU (BCES00220) and US (BCUS98119) core.xpp
 * (lt2_if1 notes / idx_core_usa.json). */
static const rsx_lt_entry s_lt2_keys[] = {
    /* inFAMOUS 1 static thrusters (glide): the trailing wisps and the ring, tinted (0.25, 0.50, 1) per vertex like the
     * other fx_white textures; EU core.xpp 06B930A0 / 07267AA0 = US 06BADEA0 / 0728D4A0 */
    { 0xb5e275f636fb838aull, 256,  64, 0x88, 9, 2, 2, 'W', 255, 0x06B930A0u },
    { 0xabd6d922bb81a19aull,  64,  64, 0x88, 7, 2, 2, 'W', 255, 0x07267AA0u },
    /* inFAMOUS 2 (lt2_fam notes; i2.core.xpps offsets): the grenade glow dot and the glide hand glow
     * (pale blue in the texture: C), the spark streaks and the white palm-core glow dot (white x the run-time tint: W,
     * so only draws with the electric tint change -- both are shared with other fx). The palm dot is byte-identical to
     * if1 core.xpp 072E3A20 (ltcolor notes ADDED_if1_textures.tsv), dropped from the sets before the tint gate. */
    { 0x05ce655d77645c0full,  32,  32, 0x88, 6, 1, 1, 'C', 255, 0x0688E550u },
    { 0x43d9802e6bc49b95ull,  64,  64, 0x88, 7, 1, 1, 'C', 255, 0x0681C850u },
    { 0x61ead6af22206b05ull,  32,  32, 0x88, 6, 1, 2, 'W', 255, 0x068845D0u },
    { 0x0e4121f8364cc1baull,  16,  16, 0x88, 5, 1, 2, 'W', 255, 0x06895250u },
};
enum { LT2_N_KEYS = (int)(sizeof s_lt2_keys / sizeof s_lt2_keys[0]) };
static inline const rsx_lt_entry* eng_lt_entry(int row) { return row < (int)LT_N_KEYS ? &s_lt_keys[row] : &s_lt2_keys[row - (int)LT_N_KEYS]; }

enum { LT_HUE_DEFAULT = -1, LT_HUE_WHITE = -2, LT_HUE_IDENTITY = -3, LT_HUE_UNSET = -100 };
volatile int g_ps3_lt_hue = LT_HUE_UNSET;     /* shared with the quick menu (vk_quickmenu.inc) */
volatile unsigned g_ps3_lt_gen = 1;           /* bumped by every colour change */
static int s_lt_on = -1, s_lt_per_frame = 6;
static u32 s_upload_lt, s_upload_lt_gen;      /* eng_texture_upload: the table row + 1 it identified, and the generation */
static struct {
    u32 seen[LT_N_KEYS + LT2_N_KEYS];         /* first frame + 1 a row was identified at (0 = never) */
    u32 ident, pack_hits, shape_only, rebuilt;
    u64 ns_sum, ns_max;
    u32 budget_frame, budget_used; u64 frame_ns, frame_ns_max;
} s_lt;

/* "lightning_hue = <n>" from the first file of PS3_QM_INI (the game's own launcher ini), or LT_HUE_DEFAULT */
static int eng_lt_ini_hue(void)
{
    const char* list = getenv("PS3_QM_INI");
    if (!list || !*list) return LT_HUE_DEFAULT;
    char path[512]; snprintf(path, sizeof path, "%s", list);
    char* c = strchr(path, ':'); if (c) *c = 0;
    FILE* f = fopen(path, "rb");
    if (!f) return LT_HUE_DEFAULT;
    char line[256]; int v = LT_HUE_DEFAULT;
    while (fgets(line, sizeof line, f)) {
        const char* t = line; while (*t == ' ') t++;
        if (!strncmp(t, "lightning_hue", 13) && (t[13] == ' ' || t[13] == '=')) {
            t += 13; while (*t == ' ' || *t == '=') t++;
            const int n = atoi(t);
            v = (n >= 0 && n < 360) || n == LT_HUE_WHITE ? n : LT_HUE_DEFAULT;
        }
    }
    fclose(f);
    return v;
}
static int eng_lt_parse_hue(const char* e)
{
    if (!e || !*e || !strcmp(e, "default")) return LT_HUE_DEFAULT;
    if (!strcmp(e, "white")) return LT_HUE_WHITE;
    if (!strcmp(e, "identity")) return LT_HUE_IDENTITY;
    const int n = atoi(e);
    return n >= 0 && n < 360 ? n : LT_HUE_DEFAULT;
}
/* The master switch, read at first use (the PS5 sets the environment inside main). Also used by the quick menu. */
int ps3_lightning_live(void)
{
    if (__builtin_expect(s_lt_on < 0, 0)) {
        const char* e = getenv("PS3_LIGHTNING_LIVE");
        s_lt_on = e && *e == '1';
        if (s_lt_on) {
            const char* h = getenv("PS3_LIGHTNING_HUE");
            const int hue = h && *h ? eng_lt_parse_hue(h) : eng_lt_ini_hue();
            int unset = LT_HUE_UNSET;
            __atomic_compare_exchange_n(&g_ps3_lt_hue, &unset, hue, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
            const char* pf = getenv("PS3_LIGHTNING_PER_FRAME");
            if (pf && atoi(pf) > 0) s_lt_per_frame = atoi(pf);
            fprintf(stderr, "[lightning] live colour on: hue %d (%s), %d key(s) in %d shape(s), %d rebuild(s) a frame\n",
                    g_ps3_lt_hue, h && *h ? "PS3_LIGHTNING_HUE" : "ini/default", (int)LT_N_KEYS, (int)LT_N_SHAPES, s_lt_per_frame);
        }
    }
    return s_lt_on;
}

static int eng_lt_find(u64 key)
{
    int lo = 0, hi = (int)LT_N_KEYS - 1;
    while (lo <= hi) {
        const int mid = (lo + hi) >> 1;
        if (s_lt_keys[mid].key == key) return mid;
        if (s_lt_keys[mid].key < key) lo = mid + 1; else hi = mid - 1;
    }
    for (int i = 0; i < (int)LT2_N_KEYS; i++) if (s_lt2_keys[i].key == key) return (int)LT_N_KEYS + i;   /* lt2 */
    return -1;
}

/* One colour through the packs' HSV maths (mods2 notes recolor.apply_colour 'set' + lt_build's W compensation). */
static void eng_lt_colour(u8 c[3], int hue, int white_cls)
{
    if (hue == LT_HUE_IDENTITY) return;
    const float r = c[0] / 255.0f, gg = c[1] / 255.0f, b = c[2] / 255.0f;
    const float mx = r > gg ? (r > b ? r : b) : (gg > b ? gg : b), mn = r < gg ? (r < b ? r : b) : (gg < b ? gg : b);
    const float s = mx > 1e-12f ? (mx - mn) / mx : 0.0f;
    float h, s2, v2;
    if (hue == LT_HUE_WHITE) { h = 0.0f; s2 = 0.0f; v2 = mx * 1.15f; if (v2 > 1.0f) v2 = 1.0f; }
    else { h = (float)hue; s2 = s + (white_cls ? 0.80f : 0.25f); if (s2 > 1.0f) s2 = 1.0f; v2 = mx; }
    const float hh = h / 60.0f; const int i = (int)hh % 6;
    const float fm2 = hh - 2.0f * (float)(int)(hh * 0.5f), d1 = fm2 - 1.0f;   /* |hh mod 2 - 1| */
    const float ch = v2 * s2, x = ch * (1.0f - (d1 < 0.0f ? -d1 : d1)), m = v2 - ch;
    float rgb[3];
    switch (i) {
    case 0: rgb[0] = ch; rgb[1] = x;  rgb[2] = 0;  break;
    case 1: rgb[0] = x;  rgb[1] = ch; rgb[2] = 0;  break;
    case 2: rgb[0] = 0;  rgb[1] = ch; rgb[2] = x;  break;
    case 3: rgb[0] = 0;  rgb[1] = x;  rgb[2] = ch; break;
    case 4: rgb[0] = x;  rgb[1] = 0;  rgb[2] = ch; break;
    default: rgb[0] = ch; rgb[1] = 0; rgb[2] = x;  break;
    }
    static const float comp[3] = { 1.0f, 0.70f / 0.86f, 0.70f };
    for (int k = 0; k < 3; k++) {
        float o = (rgb[k] + m) * 255.0f; if (o > 255.0f) o = 255.0f; if (o < 0.0f) o = 0.0f;
        o = (float)(int)(o + 0.5f);
        if (white_cls) o = (float)(int)(o * comp[k] + 0.5f);
        c[k] = (u8)(o > 255.0f ? 255.0f : o);
    }
}

/* One DXT5 level (blocks in host order, as rsx_texture_decode leaves them) to RGBA8 with the colour applied to each
 * block's four palette colours (every texel is one of them, so this is the per-texel maths at a quarter the work). */
static void eng_lt_level(const u8* blocks, u32 row_bytes, u32 w, u32 h, u8* rgba, int hue, int white_cls)
{
    for (u32 by = 0; by * 4 < h; by++)
        for (u32 bx = 0; bx * 4 < w; bx++) {
            const u8* b = blocks + (size_t)by * row_bytes + (size_t)bx * 16u;
            u8 a[8]; a[0] = b[0]; a[1] = b[1];
            if (a[0] > a[1]) for (int k = 1; k < 7; k++) a[k + 1] = (u8)(((7 - k) * a[0] + k * a[1] + 3) / 7);
            else { for (int k = 1; k < 5; k++) a[k + 1] = (u8)(((5 - k) * a[0] + k * a[1] + 2) / 5); a[6] = 0; a[7] = 255; }
            u64 abits = 0; for (int k = 0; k < 6; k++) abits |= (u64)b[2 + k] << (8 * k);
            const u8* cb = b + 8;
            const u32 c0 = (u32)cb[0] | ((u32)cb[1] << 8), c1 = (u32)cb[2] | ((u32)cb[3] << 8);
            u8 pal[4][3];
            pal[0][0] = (u8)((((c0 >> 11) & 31u) * 527u + 23u) >> 6); pal[0][1] = (u8)((((c0 >> 5) & 63u) * 259u + 33u) >> 6); pal[0][2] = (u8)(((c0 & 31u) * 527u + 23u) >> 6);
            pal[1][0] = (u8)((((c1 >> 11) & 31u) * 527u + 23u) >> 6); pal[1][1] = (u8)((((c1 >> 5) & 63u) * 259u + 33u) >> 6); pal[1][2] = (u8)(((c1 & 31u) * 527u + 23u) >> 6);
            for (int k = 0; k < 3; k++) {   /* DXT5's colour block is always the four-colour mode */
                pal[2][k] = (u8)((2u * pal[0][k] + pal[1][k]) / 3u);
                pal[3][k] = (u8)((pal[0][k] + 2u * pal[1][k]) / 3u);
            }
            for (int p = 0; p < 4; p++) eng_lt_colour(pal[p], hue, white_cls);
            const u32 idx = (u32)cb[4] | ((u32)cb[5] << 8) | ((u32)cb[6] << 16) | ((u32)cb[7] << 24);
            for (u32 i = 0; i < 16; i++) {
                const u32 x = bx * 4 + (i & 3), y = by * 4 + (i >> 2);
                if (x >= w || y >= h) continue;
                u8* o = rgba + ((size_t)y * w + x) * 4;
                const u8* pc = pal[(idx >> (2 * i)) & 3u];
                o[0] = pc[0]; o[1] = pc[1]; o[2] = pc[2]; o[3] = a[(abits >> (3 * i)) & 7u];
            }
        }
}

/* eng_texture_upload's hook (PS3_LIGHTNING_LIVE=1 only): the recoloured RGBA8 texture for a lightning texture, or 0
 * (not one; the colour is DEFAULT; or it cannot be made: the original upload goes on as always). */
static u32 eng_lt_upload(u32 location, u32 offset, u32 fmt, u32 w, u32 h, u32 nlv,
                         const rsx_tex_level* lv, const u8* src, u32 span, u32 remap)
{
    if (lv[0].tl.fmt != RSX_TEXFMT_BC3 || w > 4095u || h > 4095u) return 0;
    const u32 shape = ((fmt & 0x9Fu) << 24) | (w << 12) | h;
    int hit = 0;
    for (u32 i = 0; i < LT_N_SHAPES; i++) if (s_lt_shape[i] == shape) { hit = 1; break; }
    for (u32 i = 0; i < (u32)LT2_N_KEYS && !hit; i++)   /* lt2 rows' shapes */
        hit = ((((u32)s_lt2_keys[i].fmt & 0x9Fu) << 24) | ((u32)s_lt2_keys[i].w << 12) | s_lt2_keys[i].h) == shape;
    if (!hit) return 0;
    int readable = 0;
    const u64 content = eng_texture_content_hash(location, offset, span, &readable);
    if (!readable) return 0;
    const u64 key = eng_texmod_key(content, fmt, w, h);
    const int row = eng_lt_find(key);
    if (row < 0) { s_lt.shape_only++; return 0; }
    const rsx_lt_entry* le = eng_lt_entry(row);
    if (le->cls == 'P') {   /* a file colour pack's texture: not ours to recolour */
        if (!s_lt.seen[row]) {
            s_lt.seen[row] = g.frames + 1u; s_lt.pack_hits++;
            if (s_lt.pack_hits <= 4u)
                fprintf(stderr, "[lightning] texture %ux%u at 0x%08X is the file colour pack \"%s\"'s (%s %08X): live colour"
                                " cannot change it; set the pack colour to DEFAULT\n", w, h, offset,
                        s_lt_pack_colour[le->colour], s_lt_game_name[le->game], le->pack_off);
        }
        return 0;
    }
    if (!s_lt.seen[row]) {
        s_lt.seen[row] = g.frames + 1u; s_lt.ident++;
        fprintf(stderr, "[lightning] identified %s %s %c %ux%u mips %u (pack %08X) at 0x%08X key %016llx frame %u (%u so far)\n",
                s_lt_game_name[le->game], s_lt_set_name[le->set], le->cls, w, h, nlv, le->pack_off, offset,
                (unsigned long long)key, g.frames, s_lt.ident);
    }
    const u32 gen = __atomic_load_n(&g_ps3_lt_gen, __ATOMIC_ACQUIRE);
    const int hue = __atomic_load_n(&g_ps3_lt_hue, __ATOMIC_ACQUIRE);
    s_upload_lt = (u32)row + 1u; s_upload_lt_gen = gen;
    if (hue == LT_HUE_DEFAULT || hue == LT_HUE_UNSET) return 0;
    /* lt2: class W stays the game's texture; the draws that carry the electric tint get the colour per draw
     * (rsx_lightning_rules.inc eng_lt_tint_draw), so smoke / dust sharing a W texture keep theirs */
    if (le->cls == 'W' && hue != LT_HUE_IDENTITY) return 0;
    const uint64_t t0 = ps3_ft_now();
    u8* rgba = (u8*)malloc((size_t)w * h * 4u);
    if (!rgba) return 0;
    const u32 handle = g.be->texture_create(g.be->user, RSX_BE_FMT_R8G8B8A8, w, h, nlv, 1, remap, fmt);
    if (!handle) { free(rgba); return 0; }
    for (u32 m = 0; m < nlv; m++) {
        const rsx_tex_layout* tl = &lv[m].tl;
        if (!eng_staging_reserve(tl->dst_row_bytes * tl->rows)) { free(rgba); g.be->texture_release(g.be->user, handle); return 0; }
        rsx_texture_decode(g.tex_staging, tl->dst_row_bytes, src + lv[m].offset, lv[m].w, lv[m].h, tl, rsx_texture_argb_is_rgba());
        eng_lt_level(g.tex_staging, tl->dst_row_bytes, lv[m].w, lv[m].h, rgba, hue, le->cls == 'W');
        g.be->texture_upload(g.be->user, handle, 0, m, lv[m].w, lv[m].h, rgba, lv[m].w * 4u, lv[m].h);
    }
    free(rgba);
    const u64 ns = ps3_ft_now() - t0;
    s_lt.rebuilt++; s_lt.ns_sum += ns; if (ns > s_lt.ns_max) s_lt.ns_max = ns;
    if (s_lt.budget_frame == g.frames) s_lt.frame_ns += ns; else { s_lt.budget_frame = g.frames; s_lt.budget_used = 0; s_lt.frame_ns = ns; }
    if (s_lt.frame_ns > s_lt.frame_ns_max) s_lt.frame_ns_max = s_lt.frame_ns;
    return handle;
}

/* A line once the rebuilds of a change are over (30 frames without one): what the change cost. Called from the bind of
 * a lightning cache entry (feature on only). */
static void eng_lt_tick(void)
{
    if (!s_lt.rebuilt || g.frames - s_lt.budget_frame < 30u) return;
    fprintf(stderr, "[lightning] gen %u hue %d: %u texture(s) rebuilt, %.0f us each on average, max %.0f us; worst frame %.0f us"
                    " of rebuilds (%d a frame); %u identified, %u file-pack, %u shape-only\n",
            __atomic_load_n(&g_ps3_lt_gen, __ATOMIC_ACQUIRE), __atomic_load_n(&g_ps3_lt_hue, __ATOMIC_ACQUIRE), s_lt.rebuilt,
            (double)s_lt.ns_sum / 1e3 / (double)s_lt.rebuilt, (double)s_lt.ns_max / 1e3, (double)s_lt.frame_ns_max / 1e3,
            s_lt_per_frame, s_lt.ident, s_lt.pack_hits, s_lt.shape_only);
    s_lt.rebuilt = 0; s_lt.ns_sum = 0; s_lt.ns_max = 0; s_lt.frame_ns_max = 0;
}

/* eng_texture_slot_impl: may a stale lightning entry be made again this frame? (PS3_LIGHTNING_PER_FRAME a frame) */
static int eng_lt_budget(void)
{
    if (s_lt.budget_frame != g.frames) { s_lt.budget_frame = g.frames; s_lt.budget_used = 0; s_lt.frame_ns = 0; }
    if (s_lt.budget_used >= (u32)s_lt_per_frame) return 0;
    s_lt.budget_used++;
    return 1;
}
